<Phase number="0">
<Node dbConnection="JDBC0" enabled="enabled" guiName="Faturamento / Margem de Contribuição " guiX="5" guiY="15" id="FATURAMENTO_MARGEM_DE_CONTRIBUICAO" type="DB_INPUT_TABLE">
<attr name="sqlQuery"><![CDATA[SELECT
	  D2_FILIAL + D2_DOC + D2_SERIE + D2_CLIENTE2 + D2_LOJA + D2_COD + D2_ITEM AS FK_SD2,
	  D2_FILIAL + D2_DOC + D2_SERIE + D2_CLIENTE2 + D2_LOJA                    AS FK_SF2,
	  D2_CF_NUM,
	  D2_CF,
	  DESC_CODIGO_FISCAL,
	  D2_TES,
	  F4_ESTOQUE,
	  F4_DUPLIC,
	  F4_XCTR,
	  F4_TEXTO,

	  D2_GRUPO, 
	  D2_FILIAL,
	  A3_COD, 
	  A3_NOME, 
	  B1_COD,
	  B1_CUSTO,
	  CUSTO,
	  B1_CUSTO_DESC,
	  B1_DESC, 
	  D2_QUANT, 
	  D2_TOTAL, 
	  F2_EMISSAO,
	  CASE
		  WHEN F2_DAUTNFE = ' ' THEN NULL
		  ELSE F2_DAUTNFE
	  END AS F2_DAUTNFE,
	  D2_VALICM, 
	  D2_VALIMP5,
	  D2_VALIMP6,
	  D2_DOC,
	  D1_DOC,
	  A1_NOME_CLI,
	  A1_COD_CLI,
	  CLIENTE,
	  A1_LOJA, 
	  D2_CLIENTE,
	  D2_PEDIDO,
	  D2_ITEM,
	  D2_VALDEV,
	  D2_QTDEDEV,
	  DATAATUAL,
	  F2_DOC,
	  D2_DESCON,
	  D2_PESO,
	  A1_GRPTRIB,
	  NOTA_FISCAL,
	  D2_BASEICM,
	  D2_PRODUTIVIDADE,
	  D1_DTDIGIT,
	  D2_VALIPI,
	  D2_ICMSRET,
	  D2_SEGURO,
	  F2_FRETE_EXTRA,
	  SUBSTRING(ULTIMA_NF,1,8)         AS DATA_ULTIMA_NF,
	  SUBSTRING(PEN_ULTIMA_NF,1,8)     AS DATA_PEN_ULTIMA_NF,
	  SUBSTRING(ANT_PEN_ULTIMA_NF,1,8) AS DATA_ANT_PEN_ULTIMA_NF,
	  --------------------------------------------------------------------------------------------------------------------------------------
	  CASE
		  WHEN LTRIM(RTRIM(SUBSTRING(ULTIMA_NF,10,LEN(ULTIMA_NF))))                 = LTRIM(RTRIM(D2_DOC + '-' + CLIENTE)) THEN 'Sim'
		  ELSE 'Nao'
	  END AS E_ULTIMA_NF,
	  --------------------------------------------------------------------------------------------------------------------------------------
	  CASE
		  WHEN LTRIM(RTRIM(SUBSTRING(PEN_ULTIMA_NF,10,LEN(PEN_ULTIMA_NF))))         = LTRIM(RTRIM(D2_DOC + '-' + CLIENTE)) THEN 'Sim'
		  ELSE 'Nao'
	  END AS E_PEN_ULTIMA_NF,
	  --------------------------------------------------------------------------------------------------------------------------------------
	  CASE
		  WHEN LTRIM(RTRIM(SUBSTRING(ANT_PEN_ULTIMA_NF,10,LEN(ANT_PEN_ULTIMA_NF)))) = LTRIM(RTRIM(D2_DOC + '-' + CLIENTE)) THEN 'Sim'
		  ELSE 'Nao'
	  END AS E_ANT_PEN_ULTIMA_NF,
	  --------------------------------------------------------------------------------------------------------------------------------------
	  D2_RECEITA_FRETE,
	  D2_DESPESA_FRETE,
	  TEM_LIBERACAO,
	  F2_CARGA,
	  F2_SEQCAR,
	  D2_ALQICM,
	  D2_BASIMP5,
	  D2_ALQIMP5,
	  D2_BASIMP6,
	  D2_ALQIMP6,
	  TIPO_MOVI,
	  'Dia ' + CONVERT(VARCHAR(10), GETDATE(), 103) + ' as ' + CONVERT(VARCHAR(8), GETDATE(), 108) AS D2_DATA_CARGA,
	  TIPO_MOVI2,
	  D1_VLRDEV,
	  CT1_CONTA

FROM(
SELECT
	  --SUM(B1_CUSTO) AS B1_CUSTO,
	  --SUM(CUSTO) AS CUSTO,
	  --SUM(1) AS SUM_
	  --/*
	  D2_CF_NUM,
	  D2_CF,
	  DESC_CODIGO_FISCAL,
	  D2_TES,
	  F4_ESTOQUE,
	  F4_DUPLIC,
	  F4_XCTR,
	  F4_TEXTO,
	  ' ' AS ULTIMA_NF,
	  ' ' AS PEN_ULTIMA_NF,
	  ' ' AS ANT_PEN_ULTIMA_NF,
	  D2_CLIENTE,
	  D2_CLIENTE2,
	  D2_LOJA,
	  D2_SERIE,
	  D2_COD,
	  /*
	  -----------------------------------------------------------------------------------------------------------------------------------------------------
	  (SELECT CAMPO
	   FROM(
	   SELECT
	         D2_EMISSAO,
			 ROW_NUMBER() OVER (ORDER BY D2_EMISSAO DESC) AS N_LINHA,
			 -----------------------------------------------------------------------------------------
			 CASE
				 WHEN F2_AVALIST  = ' ' THEN D2_EMISSAO + '-' + D2_DOC + '-' + D2_CLIENTE
				 ELSE D2_EMISSAO + '-' + D2_DOC + '-' + F2_AVALIST
			 END AS CAMPO,
			 -----------------------------------------------------------------------------------------
			 CASE
				 WHEN F2_AVALIST  = ' ' THEN D2_CLIENTE
				 ELSE F2_AVALIST
			 END AS CLIENTE_2
			 -----------------------------------------------------------------------------------------

	   FROM SD2010 D2, SF4010 F4, SF2010 F2
       WHERE D2.D_E_L_E_T_ = ' ' AND F4.D_E_L_E_T_ = ' ' AND F2.D_E_L_E_T_ = ' '
	     AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE = 'S' AND F4_DUPLIC = 'S')                                              OR 
		                                   (F4_ESTOQUE = 'S' AND F4_XCTR   = 'S')                                              OR 
										   (F4_ESTOQUE = 'N' AND F4_DUPLIC = 'S' AND D2.D2_CF IN('5101','5924','6101','6924')) OR
										   (F4_ESTOQUE = 'S' AND F4_DUPLIC = 'N' AND D2.D2_CF IN('5101','5924','6101','6924'))
 										  )
         AND APL.D2_CF        IN('OK','5101','5924','6101','6924')
		 AND D2_GRUPO NOT IN('0011','0021')
		 AND SUBSTRING(D2.D2_EMISSAO,1,4) >= '2022'
		 AND D2_DOC = F2_DOC    AND D2_SERIE = F2_SERIE AND D2_CLIENTE = F2_CLIENTE AND D2_LOJA = F2_LOJA AND D2_FILIAL = F2_FILIAL
		 AND CASE WHEN F2_AVALIST  = ' ' THEN D2_CLIENTE ELSE F2_AVALIST END = APL.CLIENTE
	   
	   GROUP BY D2_EMISSAO, 
	            CASE WHEN F2_AVALIST  = ' ' THEN D2_EMISSAO + '-' + D2_DOC + '-' + D2_CLIENTE
				     ELSE D2_EMISSAO + '-' + D2_DOC + '-' + F2_AVALIST END,
				CASE WHEN F2_AVALIST  = ' ' THEN D2_CLIENTE
				     ELSE F2_AVALIST END
	   )SUB 
	   WHERE SUB.N_LINHA = 1 
	   ) AS ULTIMA_NF,
	  -----------------------------------------------------------------------------------------------------------------------------------------------------
	  (SELECT CAMPO
	   FROM(
	   SELECT
	         D2_EMISSAO,
			 ROW_NUMBER() OVER (ORDER BY D2_EMISSAO DESC) AS N_LINHA,
			 -----------------------------------------------------------------------------------------
			 CASE
				 WHEN F2_AVALIST  = ' ' THEN D2_EMISSAO + '-' + D2_DOC + '-' + D2_CLIENTE
				 ELSE D2_EMISSAO + '-' + D2_DOC + '-' + F2_AVALIST
			 END AS CAMPO,
			 -----------------------------------------------------------------------------------------
			 CASE
				 WHEN F2_AVALIST  = ' ' THEN D2_CLIENTE
				 ELSE F2_AVALIST
			 END AS CLIENTE_2
			 -----------------------------------------------------------------------------------------

	   FROM SD2010 D2, SF4010 F4, SF2010 F2
       WHERE D2.D_E_L_E_T_ = ' ' AND F4.D_E_L_E_T_ = ' ' AND F2.D_E_L_E_T_ = ' '
	     AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE = 'S' AND F4_DUPLIC = 'S')                                              OR 
		                                   (F4_ESTOQUE = 'S' AND F4_XCTR   = 'S')                                              OR 
										   (F4_ESTOQUE = 'N' AND F4_DUPLIC = 'S' AND D2.D2_CF IN('5101','5924','6101','6924')) OR
										   (F4_ESTOQUE = 'S' AND F4_DUPLIC = 'N' AND D2.D2_CF IN('5101','5924','6101','6924'))
 										  )
		 AND D2_CF        IN('OK','5101','5924','6101','6924')
		 AND D2_GRUPO NOT IN('0011','0021')
		 AND SUBSTRING(D2.D2_EMISSAO,1,4) >= '2022'
		 AND D2_DOC = F2_DOC    AND D2_SERIE = F2_SERIE AND D2_CLIENTE = F2_CLIENTE AND D2_LOJA = F2_LOJA AND D2_FILIAL = F2_FILIAL
		 AND CASE WHEN F2_AVALIST  = ' ' THEN D2_CLIENTE ELSE F2_AVALIST END = APL.CLIENTE
	   
	   GROUP BY D2_EMISSAO, 
	            CASE WHEN F2_AVALIST  = ' ' THEN D2_EMISSAO + '-' + D2_DOC + '-' + D2_CLIENTE
				     ELSE D2_EMISSAO + '-' + D2_DOC + '-' + F2_AVALIST END,
				CASE WHEN F2_AVALIST  = ' ' THEN D2_CLIENTE
				     ELSE F2_AVALIST END
	   )SUB 
	   WHERE SUB.N_LINHA = 2 
	   ) AS PEN_ULTIMA_NF,
	  -----------------------------------------------------------------------------------------------------------------------------------------------------
	  (SELECT CAMPO
	   FROM(
	   SELECT
	         D2_EMISSAO,
			 ROW_NUMBER() OVER (ORDER BY D2_EMISSAO DESC) AS N_LINHA,
			 -----------------------------------------------------------------------------------------
			 CASE
				 WHEN F2_AVALIST  = ' ' THEN D2_EMISSAO + '-' + D2_DOC + '-' + D2_CLIENTE
				 ELSE D2_EMISSAO + '-' + D2_DOC + '-' + F2_AVALIST
			 END AS CAMPO,
			 -----------------------------------------------------------------------------------------
			 CASE
				 WHEN F2_AVALIST  = ' ' THEN D2_CLIENTE
				 ELSE F2_AVALIST
			 END AS CLIENTE_2
			 -----------------------------------------------------------------------------------------

	   FROM SD2010 D2, SF4010 F4, SF2010 F2
       WHERE D2.D_E_L_E_T_ = ' ' AND F4.D_E_L_E_T_ = ' ' AND F2.D_E_L_E_T_ = ' '
	     AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE = 'S' AND F4_DUPLIC = 'S')                                              OR 
		                                   (F4_ESTOQUE = 'S' AND F4_XCTR   = 'S')                                              OR 
										   (F4_ESTOQUE = 'N' AND F4_DUPLIC = 'S' AND D2.D2_CF IN('5101','5924','6101','6924')) OR
										   (F4_ESTOQUE = 'S' AND F4_DUPLIC = 'N' AND D2.D2_CF IN('5101','5924','6101','6924'))
 										  )
		 AND D2_CF        IN('OK','5101','5924','6101','6924')
		 AND D2_GRUPO NOT IN('0011','0021')
		 AND SUBSTRING(D2.D2_EMISSAO,1,4) >= '2022'
		 AND D2_DOC = F2_DOC    AND D2_SERIE = F2_SERIE AND D2_CLIENTE = F2_CLIENTE AND D2_LOJA = F2_LOJA AND D2_FILIAL = F2_FILIAL
		 AND CASE WHEN F2_AVALIST  = ' ' THEN D2_CLIENTE ELSE F2_AVALIST END = APL.CLIENTE
	   
	   GROUP BY D2_EMISSAO, 
	            CASE WHEN F2_AVALIST  = ' ' THEN D2_EMISSAO + '-' + D2_DOC + '-' + D2_CLIENTE
				     ELSE D2_EMISSAO + '-' + D2_DOC + '-' + F2_AVALIST END,
				CASE WHEN F2_AVALIST  = ' ' THEN D2_CLIENTE
				     ELSE F2_AVALIST END
	   )SUB 
	   WHERE SUB.N_LINHA = 3 
	   ) AS ANT_PEN_ULTIMA_NF,
	  -----------------------------------------------------------------------------------------------------------------------------------------------------
	  */
	  D2_GRUPO, 
	  D2_FILIAL,
	  A3_COD, 
	  A3_NOME, 
	  B1_COD,
	  B1_CUSTO,
	  CUSTO,
	  B1_CUSTO_DESC,
	  B1_DESC, 
	  D2_QUANT, 
	  D2_TOTAL,
	  F2_EMISSAO,
	  D2_VALICM, 
	  D2_VALIMP5,
	  D2_VALIMP6,
	  D2_DOC,
	  D1_DOC,
	  --------------------------------------------------------
	  ISNULL(
	  (
	   SELECT MAX(A1_COD + ' - ' + A1_LOJA + ' - ' + LTRIM(RTRIM(A1_NOME))) AS A1_NOME
	   FROM SA1010 ZZ WITH (NOLOCK)
	   WHERE ZZ.D_E_L_E_T_ = ' '
	     AND ZZ.A1_COD + ZZ.A1_LOJA = APL.CLIENTE
	  )
	  ,'0 - Cliente nao encontrado') AS A1_NOME_CLI,
	  --------------------------------------------------------
	  CLIENTE AS A1_COD_CLI,
	  CLIENTE,
	  A1_LOJA,
	  C5_LOJAAVA,
	  D2_PEDIDO,
	  D2_ITEM,
	  D2_VALDEV,
	  D2_QTDEDEV,
	  DATAATUAL,
	  F2_DOC,
	  D2_DESCON,
	  D2_PESO,
	  A1_GRPTRIB,
	  NOTA_FISCAL,
	  D2_BASEICM,
	  D2_PRODUTIVIDADE,
	  D1_DTDIGIT,
	  D2_VALIPI,
	  D2_ICMSRET,
	  D2_SEGURO,
	  F2_FRETE_EXTRA,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  CASE
		  WHEN C9_CARGA <> ' ' THEN CAST((C5_PERCFT/100)*D2_TOTAL AS DECIMAL(14,3))
		  ELSE 0
	  END AS D2_RECEITA_FRETE,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  ISNULL(
	  CAST(
	  ((D2_TOTAL)/
	  (SELECT SUM(C9_QTDLIB * C9_PRCVEN)
	   FROM SC9010 A WITH (NOLOCK), SC5010 B WITH (NOLOCK), SC6010 C WITH (NOLOCK),SB1010 D WITH (NOLOCK), SF4010 E WITH (NOLOCK)
       WHERE A.D_E_L_E_T_  = ' ' 
         AND B.D_E_L_E_T_  = ' '  
         AND C.D_E_L_E_T_  = ' '  
         AND D.D_E_L_E_T_  = ' ' 
         AND E.D_E_L_E_T_  = ' ' 
         AND SUBSTRING(B.C5_EMISSAO,1,4) >= SUBSTRING(CONVERT(VARCHAR(8), DATEADD(YEAR, -2, GETDATE()), 112),1,4)
		 AND C.C6_TES = E.F4_CODIGO  AND ((E.F4_ESTOQUE = 'S' AND E.F4_DUPLIC = 'S')                                             OR
		 	                              (E.F4_ESTOQUE = 'S' AND E.F4_XCTR   = 'S')                                             OR
		 								  (E.F4_ESTOQUE = 'N' AND E.F4_DUPLIC = 'S' AND C.C6_CF IN('5101','5924','6101','6924')) OR
		 								  (E.F4_ESTOQUE = 'S' AND E.F4_DUPLIC = 'N' AND C.C6_CF IN('5101','5924','6101','6924'))
		 								 )
         AND A.C9_PEDIDO       = C.C6_NUM 
         AND D.B1_COD          = A.C9_PRODUTO 
         AND A.C9_PEDIDO       = B.C5_NUM 
         AND C.C6_ITEM         = A.C9_ITEM 
         AND A.C9_CLIENTE     <> '000644' 
         AND B.C5_TIPO         = 'N'
		 AND A.C9_FILIAL       = SC9.C9_FILIAL
		 AND A.C9_CARGA        = SC9.C9_CARGA 
		 AND A.C9_SEQCAR       = SC9.C9_SEQCAR
		 ) 
	  )
	  AS DECIMAL(14,3))
	  ,0) *
	  ISNULL(
	  (SELECT DAK_VLFRET
	   FROM DAK010 DAK WITH (NOLOCK)
	   WHERE DAK.D_E_L_E_T_ = ' '
	     AND DAK.DAK_FILIAL = SC9.C9_FILIAL
		 AND DAK.DAK_COD    = SC9.C9_CARGA
		 AND DAK.DAK_SEQCAR = SC9.C9_SEQCAR ) 
	  ,0) AS D2_DESPESA_FRETE,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  ISNULL(C9_PEDIDO,'Sem Liberação') AS TEM_LIBERACAO,
	  F2_DAUTNFE,
	  F2_CARGA,
	  F2_SEQCAR,
	  D2_ALQICM,
	  D2_BASIMP5,
	  D2_ALQIMP5,
	  D2_BASIMP6,
	  D2_ALQIMP6,
	  TIPO_MOVI,
	  TIPO_MOVI2,
	  D1_VLRDEV,
	  CT1_CONTA
	  --*/
FROM(

SELECT	--Faturamento com TES que movimenta Estoque e Financeiro
	  D2_CF AS D2_CF_NUM,
	  'OK' AS D2_CF,
	  'OK' AS DESC_CODIGO_FISCAL,D2_TES,F4_ESTOQUE,F4_DUPLIC,F4_XCTR,F4_TEXTO,
	  D2_GRUPO,D2_FILIAL,
	  D2_LOJA,
	  D2_SERIE,
	  D2_COD,
	  ISNULL(A3_COD,'XXXXXX') AS A3_COD,ISNULL(A3_NOME,'Sem Vendedor') AS A3_NOME,
	  B1_COD,
	  -------------------------------------------------------------------
	   /*
	   CASE
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN (D2_CUSTO1/D2_QUANT)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN (B9_CM1)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
		   AND D2_CUSTO1   = 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN B2_CM1	   	  
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN (D2_CUSTO1/D2_QUANT) --((D2_CUSTO1/D2_QUANT)+((D2_CUSTO1/D2_QUANT)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB = '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN B9_CM1 --((B9_CM1)+((B9_CM1)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1   = 0
		   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN B2_CM1 --(B2_CM1+(B2_CM1*0.07))
	  	  ----------------------------
	  	  ELSE 0
	   END AS B1_CUSTO,
	   */
	  -------------------------------------------------------------------
	  --/*
	  CASE
		  WHEN D2_QUANT = 0.0 THEN 0.0
		  ELSE(D2_CUSTO1/D2_QUANT) 
	  END AS B1_CUSTO,
	  --*/
	  --0.0 AS B1_CUSTO,
	  -------------------------------------------------------------------
	  CASE
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN (D2_CUSTO1/D2_QUANT)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND D2_CUSTO1   = 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN (B1_CUSTO)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN B1_CUSTO
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN ((D2_CUSTO1/D2_QUANT)+((D2_CUSTO1/D2_QUANT)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB = '104' 
	  	   AND D2_CUSTO1  = 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN ((B1_CUSTO)+((B1_CUSTO)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN (B1_CUSTO+(B1_CUSTO*0.07))
	  	  ----------------------------
	  	  ELSE 0
	  END AS CUSTO,
	  -------------------------------------------------------------------
	  CASE
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN 'D2_CUSTO1 (Custo na NF)'
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN 'B9_CM1 (Custo no fechamento estoque)'
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
		   AND D2_CUSTO1   = 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN 'B2_CM1 (Custo no saldo atual)'	   	  
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN 'D2_CUSTO1 (Custo na NF)'
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB = '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN 'B9_CM1 (Custo no fechamento estoque)'
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1   = 0
		   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN 'B2_CM1 (Custo no saldo atual)'	
	  	  ----------------------------
	  	  ELSE 'Sem Custo'
	   END AS B1_CUSTO_DESC,
	  -------------------------------------------------------------------
	  --*/
	  B1_DESC,D2_QUANT,D2_TOTAL,F2_EMISSAO,F2_DAUTNFE,D2_VALICM,D2_VALIMP5,D2_VALIMP6,D2_DOC,' ' AS D1_DOC,CLIENTE,D2_CLIENTE,D2_CLIENTE2,A1_LOJA,C5_LOJAAVA,D2_PEDIDO,D2_ITEMPV,D2_ITEM,
	  0.0 AS D2_VALDEV,0.0 AS D2_QTDEDEV,
	  DATAATUAL,F2_DOC,D2_DESCON,D2_PESO,A1_GRPTRIB,NOTA_FISCAL,D2_BASEICM,
	  D2_PRODUTIVIDADE,
	  NULL AS D1_DTDIGIT,
	  D2_VALIPI,
	  D2_ICMSRET,
	  D2_SEGURO,
	  D2_FRETE AS F2_FRETE_EXTRA,
	  C5_PERCFT,
	  F2_CARGA,
	  F2_SEQCAR,
	  -----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
	  CASE
		  WHEN D2_VALICM = 0 THEN '00%'
		  WHEN CAST(((D2_VALICM/(D2_TOTAL+D2_VALIPI+D2_FRETE+D2_ICMSRET+D2_SEGURO))*100) AS DECIMAL(15,0)) < 10 THEN '0' + LTRIM(RTRIM(CAST(CAST(((D2_VALICM/(D2_TOTAL+D2_VALIPI+D2_FRETE+D2_ICMSRET+D2_SEGURO))*100) AS DECIMAL(15,0)) AS VARCHAR(15)))) + '%'
		  ELSE LTRIM(RTRIM(CAST(CAST(((D2_VALICM/(D2_TOTAL+D2_VALIPI+D2_FRETE+D2_ICMSRET+D2_SEGURO))*100) AS DECIMAL(15,0)) AS VARCHAR(15)))) + '%'
	  END AS D2_ALQICM,
	  -----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
	  D2_BASIMP5,
	  D2_ALQIMP5,
	  D2_BASIMP6,
	  D2_ALQIMP6,
	  'Saida de NF' AS TIPO_MOVI,
	  'C'           AS TIPO_MOVI2,
	  D1_VLRDEV,
	  ISNULL(CT1_CONTA,'XXX') AS CT1_CONTA

FROM(
SELECT --| Venda |
	  D2_GRUPO, 
	  D2_FILIAL, 
	  --A3_COD, 
	  --A3_NOME, 
	  D2_LOJA,
	  D2_SERIE,
	  B1_COD,
	  B1_DESC, 
	  D2_QUANT, 
	  ----------------------------------------------------------------------
	  CASE
		  WHEN ROUND(D2_TOTAL,3,1) = 0.00 THEN D2_TOTAL + D2_DESPESA
		  ELSE ROUND(D2_TOTAL,3,1) + D2_DESPESA
	  END AS D2_TOTAL,
	  ----------------------------------------------------------------------
	  F2_EMISSAO, 
	  F2_DAUTNFE,
	  D2_VALICM + D2_DIFAL AS D2_VALICM,
	  D2_VALIMP5,
	  D2_VALIMP6,
	  D2_DOC,
	  -------------------------------------------------------------------
	  CASE
	  	 WHEN F2_AVALIST  = ' ' THEN A1_COD + A1_LOJA
	  	 WHEN F2_AVALIST <> ' ' THEN F2_AVALIST + C5_LOJAAVA
	  	 ELSE 'INDEFINIDO'
	  END AS CLIENTE, 
	  -------------------------------------------------------------------
	  D2_CLIENTE + ' - ' + A1_LOJA + ' - ' + LTRIM(RTRIM(A1_NOME)) AS  D2_CLIENTE,
	  D2_CLIENTE AS D2_CLIENTE2,
	  A1_LOJA, 
	  C5_LOJAAVA,
	  D2_PEDIDO, 
	  D2_ITEMPV,
	  D2_ITEM,
	  D2_VALDEV,
	  D2_QTDEDEV,
	  GETDATE() AS DATAATUAL,
	  F2_DOC,
	  D2_DESCON,
	  D2_PESO,
	  A1_GRPTRIB,
	  F2_DOC AS NOTA_FISCAL,
	  D2_BASEICM,
	  D2_COD,D2_LOCAL,D2_CUSTO1,B1_CUSTO,D2_EMISSAO,D2_TES,F4_ESTOQUE,F4_DUPLIC,F4_XCTR,F4_TEXTO,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  CASE
		  WHEN (SELECT MAX(SUBSTRING(C5.C5_EMISSAO,1,6))
		        FROM SC5010 C5 WITH (NOLOCK)
				WHERE C5.D_E_L_E_T_  = ' '
				  AND C5.C5_FILIAL   = D2.D2_FILIAL
				  AND C5.C5_NUM      = D2.D2_PEDIDO
			   ) >= SUBSTRING(D2_EMISSAO,1,6) THEN 'Mesmo mes'
		  ElSE 'Outro mes'
	  END AS D2_PRODUTIVIDADE,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  D2_VALIPI,
	  D2_ICMSRET,
	  D2_SEGURO,
	  D2_CF,
	  F2_VEND1,
	  (ROUND(D2.D2_TOTAL,3,1)/
	  (SELECT SUM(ROUND(AAA.D2_TOTAL,3,1))
	   FROM SD2010 AAA WITH (NOLOCK)
	   WHERE AAA.D_E_L_E_T_  = ' '
	     AND AAA.D2_FILIAL   = D2.D2_FILIAL
	     AND AAA.D2_DOC      = D2.D2_DOC
		 AND AAA.D2_SERIE    = D2.D2_SERIE  
		 AND AAA.D2_CLIENTE  = D2.D2_CLIENTE
		 AND AAA.D2_LOJA     = D2.D2_LOJA    )) *
	  F2_FRETE AS D2_FRETE,
	  ISNULL(C5_PERCFT,0) AS C5_PERCFT,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  (SELECT COUNT(*)
	   FROM SD2010 A WITH (NOLOCK)
	   WHERE A.D_E_L_E_T_ = ' '
	     AND A.D2_FILIAL  = D2.D2_FILIAL 
		 AND A.D2_DOC     =	D2.D2_DOC    
		 AND A.D2_SERIE   =	D2.D2_SERIE  
		 AND A.D2_CLIENTE =	D2.D2_CLIENTE
		 AND A.D2_LOJA    = D2.D2_LOJA ) AS D2_QTD_ITEM,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  F2_CARGA,
	  F2_SEQCAR, 
	  D2_BASIMP5,
	  LTRIM(RTRIM(CAST(CAST(D2_ALQIMP5 AS DECIMAL(15,2)) AS VARCHAR(15)))) + '%' AS D2_ALQIMP5,
	  D2_BASIMP6,
	  LTRIM(RTRIM(CAST(CAST(D2_ALQIMP6 AS DECIMAL(15,2)) AS VARCHAR(15)))) + '%' AS D2_ALQIMP6,
	  0.0 AS D1_VLRDEV,
	  D2_CONTA

FROM SD2010 D2 WITH (NOLOCK), SF4010 F4 WITH (NOLOCK), SF2010 F2 WITH (NOLOCK), /*SA3010 A3,*/ SB1010 B1 WITH (NOLOCK), SA1010 A1 WITH (NOLOCK), SC5010 C5 WITH (NOLOCK)/*, CT1010 CT1 WITH (NOLOCK)*/ --, SC6010 C6
WHERE D2.D_E_L_E_T_ = ' ' AND F4.D_E_L_E_T_ = ' ' AND F2.D_E_L_E_T_ = ' ' /*AND A3.D_E_L_E_T_ = ' '*/ AND B1.D_E_L_E_T_ = ' ' AND C5.D_E_L_E_T_ = ' ' /*AND CT1.D_E_L_E_T_ = ' '*/ --AND C6.D_E_L_E_T_ = ' '
  --------------------------------------------------------------------------------
  AND C5_FILIAL = D2_FILIAL AND C5_NUM = D2_PEDIDO
  --AND CT1.CT1_CONTA  = D2.D2_CONTA
  AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE   = 'S' AND F4_DUPLIC = 'S') OR (F4_ESTOQUE = 'S' AND F4_XCTR = 'S'))   
  --AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE = 'N' AND F4_DUPLIC = 'S'))
  --AND D2_TES      = F4_CODIGO AND ((F4_DUPLIC = 'S') OR (F4_XCTR = 'S')) 
  AND D2_DOC      = F2_DOC    AND D2_SERIE = F2_SERIE AND D2_CLIENTE = F2_CLIENTE AND D2_LOJA = F2_LOJA AND D2_FILIAL = F2_FILIAL
  AND D2_CLIENTE  = A1_COD    AND D2_LOJA  = A1_LOJA
  --AND F2_VEND1    = A3_COD 
  AND D2_COD      = B1_COD
  --AND C6.C6_FILIAL = D2.D2_FILIAL AND C6.C6_NUM = D2.D2_PEDIDO AND C6.C6_ITEM = D2.D2_ITEMPV 
  --------------------------------------------------------------------------------  
  AND SUBSTRING(D2_EMISSAO,1,4) >= '2022'--'2015'
  --AND D2_EMISSAO < '20200304'
  AND F2_TIPO     = 'N' 
  AND D2_CF NOT IN('7949')
  AND D2_DOC NOT IN('000353901')
  --AND D2_QTDEDEV  = 0
  --------------------------------------------------------------------------------
  /*
  AND D2_CUSTO1  <> 0  
  AND F2_AVALIST  = ' ' 
  AND A1_GRPTRIB <> '104'  
  AND EXISTS (SELECT B9_COD 
              FROM SB9010 
              WHERE SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) 
                AND D2_FILIAL                 = B9_FILIAL 
                AND D2_LOCAL                  = B9_LOCAL 
                AND D2_COD                    = B9_COD )
  */
  --------------------------------------------------------------------------------
)APL1
----------------------------------------------------------------------------------
LEFT  JOIN SB9010 B9 WITH (NOLOCK) ON B9.D_E_L_E_T_  = ' ' -- Saldos de Fechamentos de Esotque
                                  AND D2_COD         = B9_COD     
					              AND D2_FILIAL      = B9_FILIAL 
					              AND D2_LOCAL       = B9_LOCAL
					              AND SUBSTRING(F2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6)
----------------------------------------------------------------------------------
LEFT JOIN SB2010 B2 WITH (NOLOCK) ON B2.D_E_L_E_T_  = ' ' -- Saldos Atuais
                                 AND D2_COD         = B2_COD   
				                 AND D2_FILIAL      = B2_FILIAL
				                 AND D2_LOCAL       = B2_LOCAL
----------------------------------------------------------------------------------
LEFT JOIN SA3010 A3 WITH (NOLOCK) ON A3.D_E_L_E_T_  = ' ' -- Vendedores
                                 AND F2_VEND1       = A3.A3_COD
----------------------------------------------------------------------------------
LEFT JOIN CT1010 CT1 WITH (NOLOCK) ON CT1.D_E_L_E_T_  = ' ' -- Plano de Contas
                                  AND D2_CONTA        = CT1.CT1_CONTA
----------------------------------------------------------------------------------

--------------------
UNION
--------------------

SELECT	--Devolução com TES que movimenta Estoque e Financeiro
	  D2_CF AS D2_CF_NUM,
	  'OK' AS D2_CF,
	  'OK' AS DESC_CODIGO_FISCAL,D2_TES,F4_ESTOQUE,F4_DUPLIC,F4_XCTR,F4_TEXTO,
	  D2_GRUPO,D2_FILIAL,
	  D2_LOJA,
	  D2_SERIE,
	  D2_COD,
	  ISNULL(A3_COD,'XXXXXX') AS A3_COD,ISNULL(A3_NOME,'Sem Vendedor') AS A3_NOME,
	  B1_COD,
	  --/*
	   -------------------------------------------------------------------
	   /*
	   CASE
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN (D2_CUSTO1/D2_QUANT)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN (B9_CM1)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
		   AND D2_CUSTO1   = 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN B2_CM1	   	  
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN (D2_CUSTO1/D2_QUANT) --((D2_CUSTO1/D2_QUANT)+((D2_CUSTO1/D2_QUANT)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB = '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN B9_CM1 --((B9_CM1)+((B9_CM1)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1   = 0
		   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN B2_CM1 --(B2_CM1+(B2_CM1*0.07))
	  	  ----------------------------
	  	  ELSE 0
	   END AS B1_CUSTO,
	   */
	  -------------------------------------------------------------------
	  --/*
	  CASE
		  WHEN D2_QUANT = 0.0 THEN 0.0
		  ELSE(D2_CUSTO1/D2_QUANT) 
	  END AS B1_CUSTO,
	  --*/
	  --0.0 AS B1_CUSTO,
	  -------------------------------------------------------------------
	   
	   CASE
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB <> '104' 
	   	   AND D2_CUSTO1  <> 0
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	   	  THEN (D2_CUSTO1/D2_QUANT)
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB <> '104' 
	   	   AND D2_CUSTO1   = 0
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	   	  THEN (B1_CUSTO)
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB <> '104' 
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	   	  THEN B1_CUSTO
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB  = '104' 
	   	   AND D2_CUSTO1  <> 0
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	   	  THEN ((D2_CUSTO1/D2_QUANT)+((D2_CUSTO1/D2_QUANT)*0.07))
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB = '104' 
	   	   AND D2_CUSTO1  = 0
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	   	  THEN (B1_CUSTO)+((B1_CUSTO)*0.07)
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB = '104' 
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	   	  THEN (B1_CUSTO+(B1_CUSTO*0.07))
	   	  ----------------------------
	   	  ELSE 0
	   END AS CUSTO,
	   -------------------------------------------------------------------
	   CASE
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN 'D2_CUSTO1 (Custo na NF)'
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN 'B9_CM1 (Custo no fechamento estoque)'
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
		   AND D2_CUSTO1   = 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN 'B2_CM1 (Custo no saldo atual)'	   	  
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN 'D2_CUSTO1 (Custo na NF)'
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB = '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN 'B9_CM1 (Custo no fechamento estoque)'
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1   = 0
		   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN 'B2_CM1 (Custo no saldo atual)'	
	  	  ----------------------------
	  	  ELSE 'Sem Custo'
	   END AS B1_CUSTO_DESC,
	  -------------------------------------------------------------------
	   --*/
	  B1_DESC,
	  0.0 AS D2_QUANT,0.0 AS D2_TOTAL,D1_DTDIGIT AS F2_EMISSAO,F2_DAUTNFE,
	  D2_VALICM,
	  D2_VALIMP5,D2_VALIMP6,
	  D2_DOC,D1_DOC,CLIENTE,D2_CLIENTE,D2_CLIENTE2,A1_LOJA,C5_LOJAAVA,D2_PEDIDO,D2_ITEMPV,D2_ITEM,
	  D2_VALDEV,D2_QTDEDEV,
	  DATAATUAL,F2_DOC,
	  0.0 AS D2_DESCON,D2_PESO,
	  A1_GRPTRIB,NOTA_FISCAL,
	  0.0 AS D2_BASEICM,
	  D2_PRODUTIVIDADE,
	  D1_DTDIGIT,
	  0.0 AS D2_VALIPI,
	  0.0 AS D2_ICMSRET,
	  0.0 AS D2_SEGURO,
	  0.0 AS F2_FRETE_EXTRA,
	  0.0 AS C5_PERCFT,
	  F2_CARGA,
	  F2_SEQCAR,
	  'DEVOLUÇÃO' AS D2_ALQICM,
	  -----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
	  D2_BASIMP5,
	  D2_ALQIMP5,
	  D2_BASIMP6,
	  D2_ALQIMP6,
	  TIPO_MOVI,
	  'D' AS TIPO_MOVI2,
	  D1_VLRDEV,
	  ISNULL(CT1_CONTA,'XXX') AS CT1_CONTA
FROM(
SELECT --| Devolução |
	   D2_GRUPO, 
	   D2_FILIAL, 
	   --A3_COD, 
	   --A3_NOME, 
	   D2_LOJA,
	   D2_SERIE,
	   B1_COD,
	   B1_DESC,
	   D2_PRCVEN,
	   D2_QUANT, 
	   D2_TOTAL, 
	   F2_EMISSAO,
	   ((D1_VALICM+D2_DIFAL) *-1) AS D2_VALICM, 
	   (D1_VALIMP5*-1) AS D2_VALIMP5, 
	   (D1_VALIMP6*-1) AS D2_VALIMP6, 
	   D2_DOC, 
	   D1_DOC,
	   -------------------------------------------------------------------
	   CASE
	  	 WHEN F2_AVALIST  = ' ' THEN A1_COD + A1_LOJA
	  	 WHEN F2_AVALIST <> ' ' THEN F2_AVALIST + C5_LOJAAVA
	  	 ELSE 'INDEFINIDO'
	  END AS CLIENTE, 
	   -------------------------------------------------------------------
	   D2_CLIENTE + ' - ' + A1_LOJA + ' - ' + LTRIM(RTRIM(A1_NOME)) AS  D2_CLIENTE,
	   D2_CLIENTE AS D2_CLIENTE2,
	   A1_LOJA,
	   C5_LOJAAVA, 
	   D2_PEDIDO, 
	   D2_ITEMPV,
	   D2_ITEM,
	   --D2_VALDEV + D2_VALIPI AS D2_VALDEV,
	  (D1_TOTAL - D1_VALDESC) + D1_VALIPI + D1_ICMSRET + D2_DESPESA +
	  ISNULL(
	  (((D1_TOTAL - D1_VALDESC)/
	  (SELECT SUM(ROUND(AAA.D2_TOTAL,2,1))
	   FROM SD2010 AAA WITH (NOLOCK)
	   WHERE AAA.D_E_L_E_T_  = ' '
	     AND AAA.D2_FILIAL   = D2.D2_FILIAL
	     AND AAA.D2_DOC      = D2.D2_DOC
		 AND AAA.D2_SERIE    = D2.D2_SERIE  
		 AND AAA.D2_CLIENTE  = D2.D2_CLIENTE
		 AND AAA.D2_LOJA     = D2.D2_LOJA    )) * F2_FRETE),0) AS D2_VALDEV,
	   (D1_TOTAL - D1_VALDESC) AS D1_VLRDEV,
	   D1_QUANT AS D2_QTDEDEV,
	   GETDATE() AS DATAATUAL,
	   F2_DOC,
	   D2_DESCON,
	   D2_PESO,
	   A1_GRPTRIB,
	   F2_DOC AS NOTA_FISCAL,
	   D2_BASEICM,
	   D2_COD,D2_LOCAL,D2_CUSTO1,B1_CUSTO,D2_EMISSAO,F2_DAUTNFE,D2_TES,F4_ESTOQUE,F4_DUPLIC,F4_XCTR,F4_TEXTO,
	   -------------------------------------------------------------------------------------------------------------------------------------------------
	  CASE
		  WHEN (SELECT MAX(SUBSTRING(C5.C5_EMISSAO,1,6))
		        FROM SC5010 C5 WITH (NOLOCK)
				WHERE C5.D_E_L_E_T_  = ' '
				  AND C5.C5_FILIAL   = D2.D2_FILIAL
				  AND C5.C5_NUM      = D2.D2_PEDIDO
			   ) >= SUBSTRING(D2_EMISSAO,1,6) THEN 'Mesmo mes'
		  ElSE 'Outro mes'
	  END AS D2_PRODUTIVIDADE,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  D1_DTDIGIT,
	  D2_VALIPI,
	  D2_ICMSRET,
	  D2_SEGURO,
	  D2_CF,
	  F2_VEND1,
	  (D2.D2_TOTAL/
	  (SELECT SUM(AAA.D2_TOTAL)
	   FROM SD2010 AAA WITH (NOLOCK)
	   WHERE AAA.D_E_L_E_T_  = ' '
	     AND AAA.D2_FILIAL   = D2.D2_FILIAL
	     AND AAA.D2_DOC      = D2.D2_DOC
		 AND AAA.D2_SERIE    = D2.D2_SERIE  
		 AND AAA.D2_CLIENTE  = D2.D2_CLIENTE
		 AND AAA.D2_LOJA     = D2.D2_LOJA    )) *
	  F2_FRETE AS D2_FRETE,
	  F2_FRETE,
	  ISNULL(C5_PERCFT,0) AS C5_PERCFT,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  (SELECT COUNT(*)
	   FROM SD2010 A WITH (NOLOCK)
	   WHERE A.D_E_L_E_T_ = ' '
	     AND A.D2_FILIAL  = D2.D2_FILIAL 
		 AND A.D2_DOC     =	D2.D2_DOC    
		 AND A.D2_SERIE   =	D2.D2_SERIE  
		 AND A.D2_CLIENTE =	D2.D2_CLIENTE
		 AND A.D2_LOJA    = D2.D2_LOJA ) AS D2_QTD_ITEM,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  F2_CARGA,
	  F2_SEQCAR,
	  D2_BASIMP5,
	  LTRIM(RTRIM(CAST(CAST(D2_ALQIMP5 AS DECIMAL(15,2)) AS VARCHAR(15)))) + '%' AS D2_ALQIMP5,
	  D2_BASIMP6,
	  LTRIM(RTRIM(CAST(CAST(D2_ALQIMP6 AS DECIMAL(15,2)) AS VARCHAR(15)))) + '%' AS D2_ALQIMP6,
	  -----------------------------------------------------------------------------------------------------
	  CASE
		  WHEN SUBSTRING(D1_DTDIGIT,1,6)  = SUBSTRING(D2_EMISSAO,1,6) THEN 'Devolução mesmo mês'
		  WHEN SUBSTRING(D1_DTDIGIT,1,6) <> SUBSTRING(D2_EMISSAO,1,6) THEN 'Devolução outro mês'
		  ELSE 'Erro'
	  END AS TIPO_MOVI,
	  -----------------------------------------------------------------------------------------------------
	  D2_CONTA

FROM SD2010 D2 WITH (NOLOCK), SF4010 F4 WITH (NOLOCK), SF2010 F2 WITH (NOLOCK), /*SA3010 A3,*/ SB1010 B1 WITH (NOLOCK), SA1010 A1 WITH (NOLOCK), SD1010 D1 WITH (NOLOCK), SC5010 C5 WITH (NOLOCK)/*, CT1010 CT1 WITH (NOLOCK)*/
WHERE D2.D_E_L_E_T_  = ' ' AND F4.D_E_L_E_T_  = ' ' AND F2.D_E_L_E_T_  = ' ' /*AND A3.D_E_L_E_T_  = ' '*/ AND B1.D_E_L_E_T_  = ' ' AND D1.D_E_L_E_T_  = ' ' AND C5.D_E_L_E_T_ = ' ' /*AND CT1.D_E_L_E_T_ = ' '*/ 
  --------------------------------------------------------------------------------
  AND C5_FILIAL = D2_FILIAL AND C5_NUM = D2_PEDIDO
  --AND CT1.CT1_CONTA  = D2.D2_CONTA
  AND D1_FORNECE  = D2_CLIENTE AND D1_FILIAL = D2_FILIAL 
  
  --AND D1_ITEMORI = D2_ITEM
  AND ((D1_ITEMORI <> '' AND D1_ITEMORI = D2_ITEM) OR (D1_ITEMORI = ' ' AND D1_DOC = '000023915' AND D2_COD = D1_COD)) 
  
  AND D1_NFORI = D2_DOC AND D1_SERIORI = D2_SERIE AND D1_LOJA = D2_LOJA 
  AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE   = 'S' AND F4_DUPLIC = 'S') OR (F4_ESTOQUE = 'S' AND F4_XCTR = 'S'))   
  --AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE = 'N' AND F4_DUPLIC = 'S'))
  --AND D2_TES      = F4_CODIGO  AND ((F4_DUPLIC = 'S') OR (F4_XCTR = 'S')) 
  AND D2_DOC      = F2_DOC     AND D2_SERIE = F2_SERIE AND D2_CLIENTE = F2_CLIENTE AND D2_LOJA = F2_LOJA AND D2_FILIAL = F2_FILIAL
  AND D2_CLIENTE  = A1_COD     AND D2_LOJA = A1_LOJA
  --AND F2_VEND1    = A3_COD 
  AND D2_COD      = B1_COD
  --------------------------------------------------------------------------------
  AND SUBSTRING(D2_EMISSAO,1,4) >= '2022'--'2015'
  --AND D2_EMISSAO < '20200304'
  AND F2_TIPO     = 'N'
  AND D2_CF NOT IN('7949')
  AND D1_QUANT <> 0
  --AND D2_QTDEDEV <> 0 
  --------------------------------------------------------------------------------
  /*
  AND D2_CUSTO1  <> 0  
  AND F2_AVALIST  = ' '       
  AND A1_GRPTRIB <> '104'      
  AND EXISTS (SELECT B9_COD 
              FROM SB9010 
              WHERE SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) 
                AND D2_FILIAL                 = B9_FILIAL 
                AND D2_LOCAL                  = B9_LOCAL 
                AND D2_COD                    = B9_COD )
  */
  --------------------------------------------------------------------------------
)APL2
----------------------------------------------------------------------------------
LEFT  JOIN SB9010 B9 WITH (NOLOCK) ON B9.D_E_L_E_T_  = ' ' -- Saldos de Fechamentos de Esotque
                                  AND D2_COD         = B9_COD     
					              AND D2_FILIAL      = B9_FILIAL 
					              AND D2_LOCAL       = B9_LOCAL
					              AND SUBSTRING(F2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6)
----------------------------------------------------------------------------------
LEFT JOIN SB2010 B2 WITH (NOLOCK) ON B2.D_E_L_E_T_  = ' ' -- Saldos Atuais
                                 AND D2_COD         = B2_COD   
				                 AND D2_FILIAL      = B2_FILIAL
				                 AND D2_LOCAL       = B2_LOCAL
----------------------------------------------------------------------------------
LEFT JOIN SA3010 A3 WITH (NOLOCK) ON A3.D_E_L_E_T_  = ' ' -- Vendedores
                                 AND F2_VEND1       = A3.A3_COD
----------------------------------------------------------------------------------
LEFT JOIN CT1010 CT1 WITH (NOLOCK) ON CT1.D_E_L_E_T_  = ' ' -- Plano de Contas
                                  AND D2_CONTA        = CT1.CT1_CONTA
----------------------------------------------------------------------------------

--------------------
UNION
--------------------

SELECT	--Faturamento com TES que movimenta somente Financeiro
	  D2_CF AS D2_CF_NUM,
	  D2_CF,DESC_CODIGO_FISCAL,D2_TES,F4_ESTOQUE,F4_DUPLIC,F4_XCTR,F4_TEXTO,
	  D2_GRUPO,D2_FILIAL,
	  D2_LOJA,
	  D2_SERIE,
	  D2_COD,
	  ISNULL(A3_COD,'XXXXXX') AS A3_COD,ISNULL(A3_NOME,'Sem Vendedor') AS A3_NOME,
	  B1_COD,
	  --/*
	  -------------------------------------------------------------------
	   /*
	   CASE
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN (D2_CUSTO1/D2_QUANT)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN (B9_CM1)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
		   AND D2_CUSTO1   = 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN B2_CM1	   	  
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN (D2_CUSTO1/D2_QUANT) --((D2_CUSTO1/D2_QUANT)+((D2_CUSTO1/D2_QUANT)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB = '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN B9_CM1 --((B9_CM1)+((B9_CM1)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1   = 0
		   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN B2_CM1 --(B2_CM1+(B2_CM1*0.07))
	  	  ----------------------------
	  	  ELSE 0
	   END AS B1_CUSTO,
	   */
	  -------------------------------------------------------------------
	  --/*
	  CASE
		  WHEN D2_QUANT = 0.0 THEN 0.0
		  ELSE(D2_CUSTO1/D2_QUANT) 
	  END AS B1_CUSTO,
	  --*/
	  --0.0 AS B1_CUSTO,
	  -------------------------------------------------------------------
	  CASE
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN (D2_CUSTO1/D2_QUANT)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND D2_CUSTO1   = 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN (B1_CUSTO)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN B1_CUSTO
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN ((D2_CUSTO1/D2_QUANT)+((D2_CUSTO1/D2_QUANT)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB = '104' 
	  	   AND D2_CUSTO1  = 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN ((B1_CUSTO)+((B1_CUSTO)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN (B1_CUSTO+(B1_CUSTO*0.07))
	  	  ----------------------------
	  	  ELSE 0
	  END AS CUSTO,
	  -------------------------------------------------------------------
	  CASE
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN 'D2_CUSTO1 (Custo na NF)'
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN 'B9_CM1 (Custo no fechamento estoque)'
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
		   AND D2_CUSTO1   = 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN 'B2_CM1 (Custo no saldo atual)'	   	  
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN 'D2_CUSTO1 (Custo na NF)'
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB = '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN 'B9_CM1 (Custo no fechamento estoque)'
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1   = 0
		   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN 'B2_CM1 (Custo no saldo atual)'	
	  	  ----------------------------
	  	  ELSE 'Sem Custo'
	   END AS B1_CUSTO_DESC,
	  -------------------------------------------------------------------
	  --*/
	  B1_DESC,D2_QUANT,D2_TOTAL,F2_EMISSAO,F2_DAUTNFE,
	  
	  ISNULL((D2_QUANT/NULLIF(D2_QUANT_DIV,0.0)),0.00) * D2_VALICM  AS D2_VALICM,
	  ISNULL((D2_QUANT/NULLIF(D2_QUANT_DIV,0.0)),0.00) * D2_VALIMP5 AS D2_VALIMP5,
	  ISNULL((D2_QUANT/NULLIF(D2_QUANT_DIV,0.0)),0.00) * D2_VALIMP6 AS D2_VALIMP6,
	  
	  D2_DOC,' ' AS D1_DOC,CLIENTE,D2_CLIENTE,D2_CLIENTE2,A1_LOJA,C5_LOJAAVA,D2_PEDIDO,D2_ITEMPV,D2_ITEM,
	  0.0 AS D2_VALDEV,0.0 AS D2_QTDEDEV,
	  DATAATUAL,F2_DOC,D2_DESCON,D2_PESO,A1_GRPTRIB,NOTA_FISCAL,
	  
	  ISNULL((D2_QUANT/NULLIF(D2_QUANT_DIV,0.0)),0.00) * D2_BASEICM AS D2_BASEICM,
	  
	  D2_PRODUTIVIDADE,
	  NULL AS D1_DTDIGIT,
	  D2_VALIPI,
	  D2_ICMSRET,
	  D2_SEGURO,
	  D2_FRETE AS F2_FRETE_EXTRA,
	  C5_PERCFT,
	  F2_CARGA,
	  F2_SEQCAR,
	  
	  -----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
	  CASE
		  WHEN D2_VALICM = 0 THEN '00%'
		  WHEN CAST((((ISNULL((D2_QUANT/NULLIF(D2_QUANT_DIV,0.0)),0.00) * D2_VALICM)/(D2_TOTAL+D2_VALIPI+D2_FRETE+D2_ICMSRET+D2_SEGURO))*100) AS DECIMAL(15,0)) < 10 THEN '0' + LTRIM(RTRIM(CAST(CAST((((ISNULL((D2_QUANT/NULLIF(D2_QUANT_DIV,0.0)),0.00) * D2_VALICM)/(D2_TOTAL+D2_VALIPI+D2_FRETE+D2_ICMSRET+D2_SEGURO))*100) AS DECIMAL(15,0)) AS VARCHAR(15)))) + '%'
		  ELSE LTRIM(RTRIM(CAST(CAST((((ISNULL((D2_QUANT/NULLIF(D2_QUANT_DIV,0.0)),0.00) * D2_VALICM)/(D2_TOTAL+D2_VALIPI+D2_FRETE+D2_ICMSRET+D2_SEGURO))*100) AS DECIMAL(15,0)) AS VARCHAR(15)))) + '%'
	  END AS D2_ALQICM,--Condicionar Campo
	  -----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
	  ISNULL((D2_QUANT/NULLIF(D2_QUANT_DIV,0.0)),0.00) * D2_BASIMP5 AS D2_BASIMP5,
	  D2_ALQIMP5,
	  ISNULL((D2_QUANT/NULLIF(D2_QUANT_DIV,0.0)),0.00) * D2_BASIMP6 AS D2_BASIMP6,
	  D2_ALQIMP6,
	  'Saida de NF' AS TIPO_MOVI,
	  'C'           AS TIPO_MOVI2,
	  D1_VLRDEV,
	  ISNULL(CT1_CONTA,'XXX') AS CT1_CONTA
FROM(
SELECT --| Venda |
	  D2_GRUPO, 
	  D2_FILIAL, 
	  --A3_COD, 
	  --A3_NOME,
	  D2_LOJA,
	  D2_SERIE,
	  B1_COD,
	  B1_DESC, 
	  D2_QUANT,
	  ----------------------------------------------------------------------
	  CASE
		  WHEN ROUND(D2_TOTAL,3,1) = 0.00 THEN D2_TOTAL + D2_DESPESA
		  ELSE ROUND(D2_TOTAL,3,1) + D2_DESPESA
	  END AS D2_TOTAL,
	  ----------------------------------------------------------------------
	  F2_EMISSAO, 
	  F2_DAUTNFE,
	  ----------------------------------------------------------------------------------------------------
	  CASE
	  	  WHEN C6.C6_CONTRAT = ' ' OR C6.C6_CONTRAT IS NULL THEN D2.D2_VALICM + D2.D2_DIFAL
	  	  WHEN D2_CF IN('5116','5117','6116','6117')        THEN D2.D2_VALICM + D2.D2_DIFAL
	  	  ELSE ISNULL((SELECT MAX(SD2A.D2_VALICM + SD2A.D2_DIFAL) --MAX(D2.D2_QUANT/NULLIF(SD2A.D2_QUANT,0.0))
	            FROM SD2010 SD2A WITH (NOLOCK)
	            ----------------------------------------------------------------------
	            INNER JOIN SC6010 SC6A WITH (NOLOCK) ON SC6A.D_E_L_E_T_ = ' '           
	                                                AND SC6A.C6_FILIAL  = SD2A.D2_FILIAL
	                                                AND SC6A.C6_NUM     = SD2A.D2_PEDIDO
	                                                AND SC6A.C6_ITEM    = SD2A.D2_ITEMPV
	            ----------------------------------------------------------------------
	            LEFT  JOIN ADB010  ADB WITH (NOLOCK) ON ADB.D_E_L_E_T_  = ' '            
	                                                AND ADB.ADB_FILIAL  = SD2A.D2_FILIAL
	                                                AND ADB.ADB_NUMCTR  = SC6A.C6_CONTRAT
	                                                AND ADB.ADB_ITEM    = SC6A.C6_ITEMCON
	            ----------------------------------------------------------------------
	            WHERE SD2A.D_E_L_E_T_ = ' '
	              AND SC6A.C6_FILIAL  = C6.C6_FILIAL
	              AND SC6A.C6_CONTRAT = C6.C6_CONTRAT
	              AND SC6A.C6_ITEMCON = C6.C6_ITEMCON
	              AND ADB.ADB_PEDCOB  = SC6A.C6_NUM
	           ),0.00) 
	  END AS D2_VALICM,  --Condicionar Campo	          
	  ----------------------------------------------------------------------------------------------------
	  CASE
	  	  WHEN C6.C6_CONTRAT = ' ' OR C6.C6_CONTRAT IS NULL THEN D2.D2_VALIMP5
	  	  WHEN D2_CF IN('5116','5117','6116','6117')        THEN D2.D2_VALIMP5
	  	  ELSE ISNULL((SELECT MAX(SD2A.D2_VALIMP5)
	            FROM SD2010 SD2A WITH (NOLOCK)
	            ----------------------------------------------------------------------
	            INNER JOIN SC6010 SC6A WITH (NOLOCK) ON SC6A.D_E_L_E_T_ = ' '           
	                                                AND SC6A.C6_FILIAL  = SD2A.D2_FILIAL
	                                                AND SC6A.C6_NUM     = SD2A.D2_PEDIDO
	                                                AND SC6A.C6_ITEM    = SD2A.D2_ITEMPV
	            ----------------------------------------------------------------------
	            LEFT  JOIN ADB010  ADB WITH (NOLOCK) ON ADB.D_E_L_E_T_  = ' '            
	                                                AND ADB.ADB_FILIAL  = SD2A.D2_FILIAL
	                                                AND ADB.ADB_NUMCTR  = SC6A.C6_CONTRAT
	                                                AND ADB.ADB_ITEM    = SC6A.C6_ITEMCON
	            ----------------------------------------------------------------------
	            WHERE SD2A.D_E_L_E_T_ = ' '
	              AND SC6A.C6_FILIAL  = C6.C6_FILIAL
	              AND SC6A.C6_CONTRAT = C6.C6_CONTRAT
	              AND SC6A.C6_ITEMCON = C6.C6_ITEMCON
	              AND ADB.ADB_PEDCOB  = SC6A.C6_NUM
	           ),0.00) 
	  END AS D2_VALIMP5,  --Condicionar Campo	          
	  ----------------------------------------------------------------------------------------------------
	  CASE
	  	  WHEN C6.C6_CONTRAT = ' ' OR C6.C6_CONTRAT IS NULL THEN D2.D2_VALIMP6
	  	  WHEN D2_CF IN('5116','5117','6116','6117')        THEN D2.D2_VALIMP6
	  	  ELSE ISNULL((SELECT MAX(SD2A.D2_VALIMP6)
	            FROM SD2010 SD2A WITH (NOLOCK)
	            ----------------------------------------------------------------------
	            INNER JOIN SC6010 SC6A WITH (NOLOCK) ON SC6A.D_E_L_E_T_ = ' '           
	                                                AND SC6A.C6_FILIAL  = SD2A.D2_FILIAL
	                                                AND SC6A.C6_NUM     = SD2A.D2_PEDIDO
	                                                AND SC6A.C6_ITEM    = SD2A.D2_ITEMPV
	            ----------------------------------------------------------------------
	            LEFT  JOIN ADB010  ADB WITH (NOLOCK) ON ADB.D_E_L_E_T_  = ' '            
	                                                AND ADB.ADB_FILIAL  = SD2A.D2_FILIAL
	                                                AND ADB.ADB_NUMCTR  = SC6A.C6_CONTRAT
	                                                AND ADB.ADB_ITEM    = SC6A.C6_ITEMCON
	            ----------------------------------------------------------------------
	            WHERE SD2A.D_E_L_E_T_ = ' '
	              AND SC6A.C6_FILIAL  = C6.C6_FILIAL
	              AND SC6A.C6_CONTRAT = C6.C6_CONTRAT
	              AND SC6A.C6_ITEMCON = C6.C6_ITEMCON
	              AND ADB.ADB_PEDCOB  = SC6A.C6_NUM
	           ),0.00) 
	  END AS D2_VALIMP6,  --Condicionar Campo	          
	  ----------------------------------------------------------------------------------------------------
	  D2_DOC,
	  -------------------------------------------------------------------
	  CASE
	  	 WHEN F2_AVALIST  = ' ' THEN A1_COD + A1_LOJA
	  	 WHEN F2_AVALIST <> ' ' THEN F2_AVALIST + C5_LOJAAVA
	  	 ELSE 'INDEFINIDO'
	  END AS CLIENTE, 
	  -------------------------------------------------------------------
	  D2_CLIENTE + ' - ' + A1_LOJA + ' - ' + LTRIM(RTRIM(A1_NOME)) AS  D2_CLIENTE,
	  D2_CLIENTE AS D2_CLIENTE2,
	  A1_LOJA, 
	  C5_LOJAAVA,
	  D2_PEDIDO, 
	  D2_ITEMPV,
	  D2_ITEM,
	  D2_VALDEV,
	  D2_QTDEDEV,
	  GETDATE() AS DATAATUAL,
	  F2_DOC,
	  D2_DESCON,
	  D2_PESO,
	  A1_GRPTRIB,
	  F2_DOC AS NOTA_FISCAL,
	  ----------------------------------------------------------------------------------------------------
	  CASE
	  	  WHEN C6.C6_CONTRAT = ' ' OR C6.C6_CONTRAT IS NULL THEN D2.D2_BASEICM
	  	  WHEN D2_CF IN('5116','5117','6116','6117')        THEN D2.D2_BASEICM
	  	  ELSE ISNULL((SELECT MAX(SD2A.D2_BASEICM)
	            FROM SD2010 SD2A WITH (NOLOCK)
	            ----------------------------------------------------------------------
	            INNER JOIN SC6010 SC6A WITH (NOLOCK) ON SC6A.D_E_L_E_T_ = ' '           
	                                                AND SC6A.C6_FILIAL  = SD2A.D2_FILIAL
	                                                AND SC6A.C6_NUM     = SD2A.D2_PEDIDO
	                                                AND SC6A.C6_ITEM    = SD2A.D2_ITEMPV
	            ----------------------------------------------------------------------
	            LEFT  JOIN ADB010  ADB WITH (NOLOCK) ON ADB.D_E_L_E_T_  = ' '            
	                                                AND ADB.ADB_FILIAL  = SD2A.D2_FILIAL
	                                                AND ADB.ADB_NUMCTR  = SC6A.C6_CONTRAT
	                                                AND ADB.ADB_ITEM    = SC6A.C6_ITEMCON
	            ----------------------------------------------------------------------
	            WHERE SD2A.D_E_L_E_T_ = ' '
	              AND SC6A.C6_FILIAL  = C6.C6_FILIAL
	              AND SC6A.C6_CONTRAT = C6.C6_CONTRAT
	              AND SC6A.C6_ITEMCON = C6.C6_ITEMCON
	              AND ADB.ADB_PEDCOB  = SC6A.C6_NUM
	           ),0.00) 
	  END AS D2_BASEICM,  --Condicionar Campo	          
	  ----------------------------------------------------------------------------------------------------
	  D2_COD,D2_LOCAL,D2_CUSTO1,B1_CUSTO,D2_EMISSAO,D2_TES,F4_ESTOQUE,F4_DUPLIC,F4_XCTR,F4_TEXTO,
	  D2_CF,
	   (SELECT X5_DESCRI                             
	    FROM SX5010 WITH (NOLOCK)
	    WHERE D_E_L_E_T_ = ' '                      
	   	  AND D2.D2_FILIAL = X5_FILIAL              
	   	  AND X5_TABELA = '13'                       
	   	  AND X5_CHAVE = D2.D2_CF)                  AS DESC_CODIGO_FISCAL,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  CASE
		  WHEN (SELECT MAX(SUBSTRING(C5.C5_EMISSAO,1,6))
		        FROM SC5010 C5 WITH (NOLOCK)
				WHERE C5.D_E_L_E_T_  = ' '
				  AND C5.C5_FILIAL   = D2.D2_FILIAL
				  AND C5.C5_NUM      = D2.D2_PEDIDO
			   ) >= SUBSTRING(D2_EMISSAO,1,6) THEN 'Mesmo mes'
		  ElSE 'Outro mes'
	  END AS D2_PRODUTIVIDADE,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  D2_VALIPI,
	  D2_ICMSRET,
	  D2_SEGURO,
	  F2_VEND1,
	  (ROUND(D2.D2_TOTAL,3,1)/
	  (SELECT SUM(ROUND(AAA.D2_TOTAL,3,1))
	   FROM SD2010 AAA WITH (NOLOCK)
	   WHERE AAA.D_E_L_E_T_  = ' '
	     AND AAA.D2_FILIAL   = D2.D2_FILIAL
	     AND AAA.D2_DOC      = D2.D2_DOC
		 AND AAA.D2_SERIE    = D2.D2_SERIE  
		 AND AAA.D2_CLIENTE  = D2.D2_CLIENTE
		 AND AAA.D2_LOJA     = D2.D2_LOJA    )) *
	  F2_FRETE AS D2_FRETE,
	  ISNULL(C5_PERCFT,0) AS C5_PERCFT,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  (SELECT COUNT(*)
	   FROM SD2010 A WITH (NOLOCK)
	   WHERE A.D_E_L_E_T_ = ' '
	     AND A.D2_FILIAL  = D2.D2_FILIAL 
		 AND A.D2_DOC     =	D2.D2_DOC    
		 AND A.D2_SERIE   =	D2.D2_SERIE  
		 AND A.D2_CLIENTE =	D2.D2_CLIENTE
		 AND A.D2_LOJA    = D2.D2_LOJA ) AS D2_QTD_ITEM,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  F2_CARGA,
	  F2_SEQCAR,
	  ----------------------------------------------------------------------------------------------------
	  CASE
	  	  WHEN C6.C6_CONTRAT = ' ' OR C6.C6_CONTRAT IS NULL THEN D2.D2_BASIMP5
	  	  WHEN D2_CF IN('5116','5117','6116','6117')        THEN D2.D2_BASIMP5
	  	  ELSE ISNULL((SELECT MAX(SD2A.D2_BASIMP5)
	            FROM SD2010 SD2A WITH (NOLOCK)
	            ----------------------------------------------------------------------
	            INNER JOIN SC6010 SC6A WITH (NOLOCK) ON SC6A.D_E_L_E_T_ = ' '           
	                                                AND SC6A.C6_FILIAL  = SD2A.D2_FILIAL
	                                                AND SC6A.C6_NUM     = SD2A.D2_PEDIDO
	                                                AND SC6A.C6_ITEM    = SD2A.D2_ITEMPV
	            ----------------------------------------------------------------------
	            LEFT  JOIN ADB010  ADB WITH (NOLOCK) ON ADB.D_E_L_E_T_  = ' '            
	                                                AND ADB.ADB_FILIAL  = SD2A.D2_FILIAL
	                                                AND ADB.ADB_NUMCTR  = SC6A.C6_CONTRAT
	                                                AND ADB.ADB_ITEM    = SC6A.C6_ITEMCON
	            ----------------------------------------------------------------------
	            WHERE SD2A.D_E_L_E_T_ = ' '
	              AND SC6A.C6_FILIAL  = C6.C6_FILIAL
	              AND SC6A.C6_CONTRAT = C6.C6_CONTRAT
	              AND SC6A.C6_ITEMCON = C6.C6_ITEMCON
	              AND ADB.ADB_PEDCOB  = SC6A.C6_NUM
	           ),0.00) 
	  END AS D2_BASIMP5,  --Condicionar Campo	          
	  ----------------------------------------------------------------------------------------------------
	  CASE
	  	  WHEN C6.C6_CONTRAT = ' ' OR C6.C6_CONTRAT IS NULL THEN LTRIM(RTRIM(CAST(CAST(D2.D2_ALQIMP5 AS DECIMAL(15,2)) AS VARCHAR(15)))) + '%'
	  	  WHEN D2_CF IN('5116','5117','6116','6117')        THEN LTRIM(RTRIM(CAST(CAST(D2.D2_ALQIMP5 AS DECIMAL(15,2)) AS VARCHAR(15)))) + '%'
	  	  ELSE ISNULL((SELECT LTRIM(RTRIM(CAST(CAST(MAX(SD2A.D2_ALQIMP5) AS DECIMAL(15,2)) AS VARCHAR(15)))) + '%'
	            FROM SD2010 SD2A WITH (NOLOCK)
	            ----------------------------------------------------------------------
	            INNER JOIN SC6010 SC6A WITH (NOLOCK) ON SC6A.D_E_L_E_T_ = ' '           
	                                                AND SC6A.C6_FILIAL  = SD2A.D2_FILIAL
	                                                AND SC6A.C6_NUM     = SD2A.D2_PEDIDO
	                                                AND SC6A.C6_ITEM    = SD2A.D2_ITEMPV
	            ----------------------------------------------------------------------
	            LEFT  JOIN ADB010  ADB WITH (NOLOCK) ON ADB.D_E_L_E_T_  = ' '            
	                                                AND ADB.ADB_FILIAL  = SD2A.D2_FILIAL
	                                                AND ADB.ADB_NUMCTR  = SC6A.C6_CONTRAT
	                                                AND ADB.ADB_ITEM    = SC6A.C6_ITEMCON
	            ----------------------------------------------------------------------
	            WHERE SD2A.D_E_L_E_T_ = ' '
	              AND SC6A.C6_FILIAL  = C6.C6_FILIAL
	              AND SC6A.C6_CONTRAT = C6.C6_CONTRAT
	              AND SC6A.C6_ITEMCON = C6.C6_ITEMCON
	              AND ADB.ADB_PEDCOB  = SC6A.C6_NUM
	           ),'0.00%') 
	  END AS D2_ALQIMP5,  --Condicionar Campo	          
	  ----------------------------------------------------------------------------------------------------
	  CASE
	  	  WHEN C6.C6_CONTRAT = ' ' OR C6.C6_CONTRAT IS NULL THEN D2.D2_BASIMP6
	  	  WHEN D2_CF IN('5116','5117','6116','6117')        THEN D2.D2_BASIMP6
	  	  ELSE ISNULL((SELECT MAX(SD2A.D2_BASIMP6)
	            FROM SD2010 SD2A WITH (NOLOCK)
	            ----------------------------------------------------------------------
	            INNER JOIN SC6010 SC6A WITH (NOLOCK) ON SC6A.D_E_L_E_T_ = ' '           
	                                                AND SC6A.C6_FILIAL  = SD2A.D2_FILIAL
	                                                AND SC6A.C6_NUM     = SD2A.D2_PEDIDO
	                                                AND SC6A.C6_ITEM    = SD2A.D2_ITEMPV
	            ----------------------------------------------------------------------
	            LEFT  JOIN ADB010  ADB WITH (NOLOCK) ON ADB.D_E_L_E_T_  = ' '            
	                                                AND ADB.ADB_FILIAL  = SD2A.D2_FILIAL
	                                                AND ADB.ADB_NUMCTR  = SC6A.C6_CONTRAT
	                                                AND ADB.ADB_ITEM    = SC6A.C6_ITEMCON
	            ----------------------------------------------------------------------
	            WHERE SD2A.D_E_L_E_T_ = ' '
	              AND SC6A.C6_FILIAL  = C6.C6_FILIAL
	              AND SC6A.C6_CONTRAT = C6.C6_CONTRAT
	              AND SC6A.C6_ITEMCON = C6.C6_ITEMCON
	              AND ADB.ADB_PEDCOB  = SC6A.C6_NUM
	           ),0.00) 
	  END AS D2_BASIMP6,  --Condicionar Campo	          
	  ----------------------------------------------------------------------------------------------------
	  CASE
	  	  WHEN C6.C6_CONTRAT = ' ' OR C6.C6_CONTRAT IS NULL THEN LTRIM(RTRIM(CAST(CAST(D2.D2_ALQIMP6 AS DECIMAL(15,2)) AS VARCHAR(15)))) + '%'
	  	  WHEN D2_CF IN('5116','5117','6116','6117')        THEN LTRIM(RTRIM(CAST(CAST(D2.D2_ALQIMP6 AS DECIMAL(15,2)) AS VARCHAR(15)))) + '%'
	  	  ELSE ISNULL((SELECT LTRIM(RTRIM(CAST(CAST(MAX(SD2A.D2_ALQIMP6) AS DECIMAL(15,2)) AS VARCHAR(15)))) + '%'
	            FROM SD2010 SD2A WITH (NOLOCK)
	            ----------------------------------------------------------------------
	            INNER JOIN SC6010 SC6A WITH (NOLOCK) ON SC6A.D_E_L_E_T_ = ' '           
	                                                AND SC6A.C6_FILIAL  = SD2A.D2_FILIAL
	                                                AND SC6A.C6_NUM     = SD2A.D2_PEDIDO
	                                                AND SC6A.C6_ITEM    = SD2A.D2_ITEMPV
	            ----------------------------------------------------------------------
	            LEFT  JOIN ADB010  ADB WITH (NOLOCK) ON ADB.D_E_L_E_T_  = ' '            
	                                                AND ADB.ADB_FILIAL  = SD2A.D2_FILIAL
	                                                AND ADB.ADB_NUMCTR  = SC6A.C6_CONTRAT
	                                                AND ADB.ADB_ITEM    = SC6A.C6_ITEMCON
	            ----------------------------------------------------------------------
	            WHERE SD2A.D_E_L_E_T_ = ' '
	              AND SC6A.C6_FILIAL  = C6.C6_FILIAL
	              AND SC6A.C6_CONTRAT = C6.C6_CONTRAT
	              AND SC6A.C6_ITEMCON = C6.C6_ITEMCON
	              AND ADB.ADB_PEDCOB  = SC6A.C6_NUM
	           ),'0.00%') 
	  END AS D2_ALQIMP6, --Condicionar Campo	          
	  ----------------------------------------------------------------------------------------------------
	  0.0 AS D1_VLRDEV,
	  ----------------------------------------------------------------------------------------------------
	  CASE
	  	  WHEN C6.C6_CONTRAT = ' ' OR C6.C6_CONTRAT IS NULL THEN D2.D2_QUANT
	  	  WHEN D2_CF IN('5116','5117','6116','6117')        THEN D2.D2_QUANT
	  	  ELSE ISNULL((SELECT MAX(SD2A.D2_QUANT)
	            FROM SD2010 SD2A WITH (NOLOCK)
	            ----------------------------------------------------------------------
	            INNER JOIN SC6010 SC6A WITH (NOLOCK) ON SC6A.D_E_L_E_T_ = ' '           
	                                                AND SC6A.C6_FILIAL  = SD2A.D2_FILIAL
	                                                AND SC6A.C6_NUM     = SD2A.D2_PEDIDO
	                                                AND SC6A.C6_ITEM    = SD2A.D2_ITEMPV
	            ----------------------------------------------------------------------
	            LEFT  JOIN ADB010  ADB WITH (NOLOCK) ON ADB.D_E_L_E_T_  = ' '            
	                                                AND ADB.ADB_FILIAL  = SD2A.D2_FILIAL
	                                                AND ADB.ADB_NUMCTR  = SC6A.C6_CONTRAT
	                                                AND ADB.ADB_ITEM    = SC6A.C6_ITEMCON
	            ----------------------------------------------------------------------
	            WHERE SD2A.D_E_L_E_T_ = ' '
	              AND SC6A.C6_FILIAL  = C6.C6_FILIAL
	              AND SC6A.C6_CONTRAT = C6.C6_CONTRAT
	              AND SC6A.C6_ITEMCON = C6.C6_ITEMCON
	              AND ADB.ADB_PEDCOB  = SC6A.C6_NUM
	           ),0.00) 
	  END AS D2_QUANT_DIV, 
	  --NULL AS D2_QUANT_DIV        
	  ----------------------------------------------------------------------------------------------------
	  D2_CONTA

FROM SD2010 D2 WITH (NOLOCK), SF4010 F4 WITH (NOLOCK), SF2010 F2 WITH (NOLOCK), /*SA3010 A3,*/ SB1010 B1 WITH (NOLOCK), SA1010 A1 WITH (NOLOCK), SC5010 C5 WITH (NOLOCK), SC6010 C6 WITH (NOLOCK)/*, CT1010 CT1 WITH (NOLOCK)*/
WHERE D2.D_E_L_E_T_ = ' ' AND F4.D_E_L_E_T_ = ' ' AND F2.D_E_L_E_T_ = ' ' /*AND A3.D_E_L_E_T_ = ' '*/ AND B1.D_E_L_E_T_ = ' ' AND C5.D_E_L_E_T_ = ' ' AND C6.D_E_L_E_T_ = ' ' /*AND CT1.D_E_L_E_T_ = ' '*/  
  --------------------------------------------------------------------------------
  AND C5_FILIAL = D2_FILIAL AND C5_NUM = D2_PEDIDO
  --AND CT1.CT1_CONTA  = D2.D2_CONTA
  --AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE   = 'S' AND F4_DUPLIC = 'S') OR (F4_ESTOQUE = 'S' AND F4_XCTR = 'S'))   
  AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE = 'N' AND F4_DUPLIC = 'S')OR(F4_ESTOQUE = 'S' AND F4_DUPLIC = 'N' AND F4_XCTR = 'N'))
  --AND D2_TES      = F4_CODIGO AND ((F4_DUPLIC = 'S') OR (F4_XCTR = 'S')) 
  AND D2_DOC      = F2_DOC    AND D2_SERIE = F2_SERIE AND D2_CLIENTE = F2_CLIENTE AND D2_LOJA = F2_LOJA AND D2_FILIAL = F2_FILIAL
  AND D2_CLIENTE  = A1_COD    AND D2_LOJA  = A1_LOJA
  --AND F2_VEND1    = A3_COD 
  AND D2_COD      = B1_COD
  AND C6.C6_FILIAL = D2.D2_FILIAL AND C6.C6_NUM = D2.D2_PEDIDO AND C6.C6_ITEM = D2.D2_ITEMPV 
  --------------------------------------------------------------------------------  
  AND SUBSTRING(D2_EMISSAO,1,4) >= '2022'--'2015'
  --AND D2_EMISSAO < '20200304'
  AND F2_TIPO     = 'N' 
  AND D2_CF NOT IN('7949')
  --AND D2_QTDEDEV  = 0
  --------------------------------------------------------------------------------
  /*
  AND D2_CUSTO1  <> 0  
  AND F2_AVALIST  = ' ' 
  AND A1_GRPTRIB <> '104'  
  AND EXISTS (SELECT B9_COD 
              FROM SB9010 
              WHERE SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) 
                AND D2_FILIAL                 = B9_FILIAL 
                AND D2_LOCAL                  = B9_LOCAL 
                AND D2_COD                    = B9_COD )
  */
  --------------------------------------------------------------------------------
)APL3
----------------------------------------------------------------------------------
LEFT  JOIN SB9010 B9 WITH (NOLOCK) ON B9.D_E_L_E_T_  = ' ' -- Saldos de Fechamentos de Esotque
                                  AND D2_COD         = B9_COD     
					              AND D2_FILIAL      = B9_FILIAL 
					              AND D2_LOCAL       = B9_LOCAL
					              AND SUBSTRING(F2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6)
----------------------------------------------------------------------------------
LEFT JOIN SB2010 B2 WITH (NOLOCK) ON B2.D_E_L_E_T_  = ' ' -- Saldos Atuais
                                 AND D2_COD         = B2_COD   
				                 AND D2_FILIAL      = B2_FILIAL
				                 AND D2_LOCAL       = B2_LOCAL
----------------------------------------------------------------------------------
LEFT JOIN SA3010 A3 WITH (NOLOCK) ON A3.D_E_L_E_T_  = ' ' -- Vendedores
                                 AND F2_VEND1       = A3.A3_COD
----------------------------------------------------------------------------------
LEFT JOIN CT1010 CT1 WITH (NOLOCK) ON CT1.D_E_L_E_T_  = ' ' -- Plano de Contas
                                  AND D2_CONTA        = CT1.CT1_CONTA
----------------------------------------------------------------------------------

--------------------
UNION
--------------------

SELECT	--Devolução com TES de saida que movimenta somente Financeiro
	  D2_CF AS D2_CF_NUM,
	  D2_CF,DESC_CODIGO_FISCAL,D2_TES,F4_ESTOQUE,F4_DUPLIC,F4_XCTR,F4_TEXTO,
	  D2_GRUPO,D2_FILIAL,
	  D2_LOJA,
	  D2_SERIE,
	  D2_COD,
	  ISNULL(A3_COD,'XXXXXX') AS A3_COD,ISNULL(A3_NOME,'Sem Vendedor') AS A3_NOME,
	  B1_COD,
	  --/*
	   -------------------------------------------------------------------
	   /*
	   CASE
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN (D2_CUSTO1/D2_QUANT)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN (B9_CM1)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
		   AND D2_CUSTO1   = 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN B2_CM1	   	  
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN (D2_CUSTO1/D2_QUANT) --((D2_CUSTO1/D2_QUANT)+((D2_CUSTO1/D2_QUANT)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB = '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN B9_CM1 --((B9_CM1)+((B9_CM1)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1   = 0
		   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN B2_CM1 --(B2_CM1+(B2_CM1*0.07))
	  	  ----------------------------
	  	  ELSE 0
	   END AS B1_CUSTO,
	   */
	  -------------------------------------------------------------------
	  --/*
	  CASE
		  WHEN D2_QUANT = 0.0 THEN 0.0
		  ELSE(D2_CUSTO1/D2_QUANT) 
	  END AS B1_CUSTO,
	  --*/
	  --0.0 AS B1_CUSTO,
	  -------------------------------------------------------------------
	   CASE
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB <> '104' 
	   	   AND D2_CUSTO1  <> 0
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	   	  THEN (D2_CUSTO1/D2_QUANT)
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB <> '104' 
	   	   AND D2_CUSTO1   = 0
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	   	  THEN (B1_CUSTO)
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB <> '104' 
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	   	  THEN B1_CUSTO
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB  = '104' 
	   	   AND D2_CUSTO1  <> 0
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	   	  THEN ((D2_CUSTO1/D2_QUANT)+((D2_CUSTO1/D2_QUANT)*0.07))
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB = '104' 
	   	   AND D2_CUSTO1  = 0
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	   	  THEN (B1_CUSTO)+((B1_CUSTO)*0.07)
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB = '104' 
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	   	  THEN (B1_CUSTO+(B1_CUSTO*0.07))
	   	  ----------------------------
	   	  ELSE 0
	   END AS CUSTO,
	   -------------------------------------------------------------------
	   CASE
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN 'D2_CUSTO1 (Custo na NF)'
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN 'B9_CM1 (Custo no fechamento estoque)'
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
		   AND D2_CUSTO1   = 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN 'B2_CM1 (Custo no saldo atual)'	   	  
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN 'D2_CUSTO1 (Custo na NF)'
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB = '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN 'B9_CM1 (Custo no fechamento estoque)'
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1   = 0
		   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 WITH (NOLOCK)
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN 'B2_CM1 (Custo no saldo atual)'	
	  	  ----------------------------
	  	  ELSE 'Sem Custo'
	   END AS B1_CUSTO_DESC,
	  -------------------------------------------------------------------
	   --*/
	  B1_DESC,
	  0.0 AS D2_QUANT,0.0 AS D2_TOTAL,D1_DTDIGIT AS F2_EMISSAO,F2_DAUTNFE,
	  D2_VALICM,
	  D2_VALIMP5,D2_VALIMP6,
	  D2_DOC,D1_DOC,CLIENTE,D2_CLIENTE,D2_CLIENTE2,A1_LOJA,C5_LOJAAVA,D2_PEDIDO,D2_ITEMPV,D2_ITEM,
	  D2_VALDEV,D2_QTDEDEV,
	  DATAATUAL,F2_DOC,
	  0.0 AS D2_DESCON,D2_PESO,
	  A1_GRPTRIB,NOTA_FISCAL,
	  0.0 AS D2_BASEICM,
	  D2_PRODUTIVIDADE,
	  D1_DTDIGIT,
	  0.0 AS D2_VALIPI,
	  0.0 AS D2_ICMSRET,
	  0.0 AS D2_SEGURO,
	  0.0 AS F2_FRETE_EXTRA,
	  0.0 AS C5_PERCFT,
	  F2_CARGA,
	  F2_SEQCAR,
	  'DEVOLUÇÃO' AS D2_ALQICM,
	  -----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
	  D2_BASIMP5,
	  D2_ALQIMP5,
	  D2_BASIMP6,
	  D2_ALQIMP6,
	  TIPO_MOVI,
	  'D' AS TIPO_MOVI2,
	  D1_VLRDEV,
	  ISNULL(CT1_CONTA,'XXX') AS CT1_CONTA
FROM(
SELECT --| Devolução |
	   D2_GRUPO, 
	   D2_FILIAL, 
	   --A3_COD, 
	   --A3_NOME,
	   D2_LOJA,
	   D2_SERIE,
	   B1_COD,
	   B1_DESC,
	   D2_PRCVEN,
	   D2_QUANT, 
	   D2_TOTAL, 
	   F2_EMISSAO,
	   F2_DAUTNFE,
	   ((D1_VALICM+D2_DIFAL)  *-1) AS D2_VALICM, 
	   (D1_VALIMP5 *-1) AS D2_VALIMP5, 
	   (D1_VALIMP6 *-1) AS D2_VALIMP6, 
	   D2_DOC,
	   D1_DOC,
	   -------------------------------------------------------------------
	   CASE
	  	 WHEN F2_AVALIST  = ' ' THEN A1_COD + A1_LOJA
	  	 WHEN F2_AVALIST <> ' ' THEN F2_AVALIST + C5_LOJAAVA
	  	 ELSE 'INDEFINIDO'
	  END AS CLIENTE,  
	   -------------------------------------------------------------------
	   D2_CLIENTE + ' - ' + A1_LOJA + ' - ' + LTRIM(RTRIM(A1_NOME)) AS  D2_CLIENTE,
	   D2_CLIENTE AS D2_CLIENTE2,
	   A1_LOJA, 
	   C5_LOJAAVA,
	   D2_PEDIDO, 
	   D2_ITEMPV,
	   D2_ITEM,
	   --D2_VALDEV + D2_VALIPI AS D2_VALDEV,
	   (D1_TOTAL - D1_VALDESC) + D1_VALIPI + D1_ICMSRET + D2_DESPESA +
	  ISNULL(
	  (((D1_TOTAL - D1_VALDESC)/
	  (SELECT SUM(ROUND(AAA.D2_TOTAL,2,1))
	   FROM SD2010 AAA WITH (NOLOCK)
	   WHERE AAA.D_E_L_E_T_  = ' '
	     AND AAA.D2_FILIAL   = D2.D2_FILIAL
	     AND AAA.D2_DOC      = D2.D2_DOC
		 AND AAA.D2_SERIE    = D2.D2_SERIE  
		 AND AAA.D2_CLIENTE  = D2.D2_CLIENTE
		 AND AAA.D2_LOJA     = D2.D2_LOJA    )) * F2_FRETE),0) AS D2_VALDEV,
	   (D1_TOTAL - D1_VALDESC) AS D1_VLRDEV,
	   D1_QUANT AS D2_QTDEDEV,
	   GETDATE() AS DATAATUAL,
	   F2_DOC,
	   D2_DESCON,
	   D2_PESO,
	   A1_GRPTRIB,
	   F2_DOC AS NOTA_FISCAL,
	   D2_BASEICM,
	   D2_COD,D2_LOCAL,D2_CUSTO1,B1_CUSTO,D2_EMISSAO,D2_TES,F4_ESTOQUE,F4_DUPLIC,F4_XCTR,F4_TEXTO,
	   D2_CF,
	   (SELECT X5_DESCRI                             
	    FROM SX5010 WITH (NOLOCK)                               
	    WHERE D_E_L_E_T_ = ' '                      
	   	  AND D2.D2_FILIAL = X5_FILIAL              
	   	  AND X5_TABELA = '13'                       
	   	  AND X5_CHAVE = D2.D2_CF)                  AS DESC_CODIGO_FISCAL,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  CASE
		  WHEN (SELECT MAX(SUBSTRING(C5.C5_EMISSAO,1,6))
		        FROM SC5010 C5 WITH (NOLOCK)
				WHERE C5.D_E_L_E_T_  = ' '
				  AND C5.C5_FILIAL   = D2.D2_FILIAL
				  AND C5.C5_NUM      = D2.D2_PEDIDO
			   ) >= SUBSTRING(D2_EMISSAO,1,6) THEN 'Mesmo mes'
		  ElSE 'Outro mes'
	  END AS D2_PRODUTIVIDADE,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  D1_DTDIGIT,
	  D2_VALIPI,
	  D2_ICMSRET,
	  D2_SEGURO,
	  F2_VEND1,
	  (D2.D2_TOTAL/
	  (SELECT SUM(AAA.D2_TOTAL)
	   FROM SD2010 AAA WITH (NOLOCK)
	   WHERE AAA.D_E_L_E_T_  = ' '
	     AND AAA.D2_FILIAL   = D2.D2_FILIAL
	     AND AAA.D2_DOC      = D2.D2_DOC
		 AND AAA.D2_SERIE    = D2.D2_SERIE  
		 AND AAA.D2_CLIENTE  = D2.D2_CLIENTE
		 AND AAA.D2_LOJA     = D2.D2_LOJA    )) *
	  F2_FRETE AS D2_FRETE,
	  F2_FRETE,
	  ISNULL(C5_PERCFT,0) AS C5_PERCFT,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  (SELECT COUNT(*)
	   FROM SD2010 A WITH (NOLOCK)
	   WHERE A.D_E_L_E_T_ = ' '
	     AND A.D2_FILIAL  = D2.D2_FILIAL 
		 AND A.D2_DOC     =	D2.D2_DOC    
		 AND A.D2_SERIE   =	D2.D2_SERIE  
		 AND A.D2_CLIENTE =	D2.D2_CLIENTE
		 AND A.D2_LOJA    = D2.D2_LOJA ) AS D2_QTD_ITEM,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  F2_CARGA,
	  F2_SEQCAR,
	  D2_BASIMP5,
	  LTRIM(RTRIM(CAST(CAST(D2_ALQIMP5 AS DECIMAL(15,2)) AS VARCHAR(15)))) + '%' AS D2_ALQIMP5,
	  D2_BASIMP6,
	  LTRIM(RTRIM(CAST(CAST(D2_ALQIMP6 AS DECIMAL(15,2)) AS VARCHAR(15)))) + '%' AS D2_ALQIMP6,
	  -----------------------------------------------------------------------------------------------------
	  CASE
		  WHEN SUBSTRING(D1_DTDIGIT,1,6)  = SUBSTRING(D2_EMISSAO,1,6) THEN 'Devolução mesmo mês'
		  WHEN SUBSTRING(D1_DTDIGIT,1,6) <> SUBSTRING(D2_EMISSAO,1,6) THEN 'Devolução outro mês'
		  ELSE 'Erro'
	  END AS TIPO_MOVI,
	  -----------------------------------------------------------------------------------------------------
	  D2_CONTA

FROM SD2010 D2 WITH (NOLOCK), SF4010 F4 WITH (NOLOCK), SF2010 F2 WITH (NOLOCK), /*SA3010 A3,*/ SB1010 B1 WITH (NOLOCK), SA1010 A1 WITH (NOLOCK), SD1010 D1 WITH (NOLOCK), SC5010 C5 WITH (NOLOCK)/*, CT1010 CT1 WITH (NOLOCK)*/
WHERE D2.D_E_L_E_T_  = ' ' AND F4.D_E_L_E_T_  = ' ' AND F2.D_E_L_E_T_  = ' ' /*AND A3.D_E_L_E_T_  = ' '*/ AND B1.D_E_L_E_T_  = ' ' AND D1.D_E_L_E_T_  = ' ' AND C5.D_E_L_E_T_ = ' ' /*AND CT1.D_E_L_E_T_ = ' '*/
  --------------------------------------------------------------------------------
  AND C5_FILIAL = D2_FILIAL AND C5_NUM = D2_PEDIDO
  --AND CT1.CT1_CONTA  = D2.D2_CONTA
  AND D1_FORNECE  = D2_CLIENTE AND D1_FILIAL = D2_FILIAL AND D1_ITEMORI = D2_ITEM AND D1_NFORI = D2_DOC AND D1_SERIORI = D2_SERIE AND D1_LOJA = D2_LOJA 
  --AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE   = 'S' AND F4_DUPLIC = 'S') OR (F4_ESTOQUE = 'S' AND F4_XCTR = 'S'))   
  AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE = 'N' AND F4_DUPLIC = 'S')OR(F4_ESTOQUE = 'S' AND F4_DUPLIC = 'N' AND F4_XCTR = 'N'))
  --AND D2_TES      = F4_CODIGO  AND ((F4_DUPLIC = 'S') OR (F4_XCTR = 'S')) 
  AND D2_DOC      = F2_DOC     AND D2_SERIE = F2_SERIE AND D2_CLIENTE = F2_CLIENTE AND D2_LOJA = F2_LOJA AND D2_FILIAL = F2_FILIAL
  AND D2_CLIENTE  = A1_COD     AND D2_LOJA = A1_LOJA
  --AND F2_VEND1    = A3_COD 
  AND D2_COD      = B1_COD
  --------------------------------------------------------------------------------
  AND SUBSTRING(D2_EMISSAO,1,4) >= '2022'--'2015'
  --AND D2_EMISSAO < '20200304'
  AND F2_TIPO     = 'N'
  AND D2_CF NOT IN('7949')
  AND D1_QUANT <> 0
  --AND D2_QTDEDEV <> 0 
  --------------------------------------------------------------------------------
  /*
  AND D2_CUSTO1  <> 0  
  AND F2_AVALIST  = ' '       
  AND A1_GRPTRIB <> '104'      
  AND EXISTS (SELECT B9_COD 
              FROM SB9010 
              WHERE SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) 
                AND D2_FILIAL                 = B9_FILIAL 
                AND D2_LOCAL                  = B9_LOCAL 
                AND D2_COD                    = B9_COD )
  */
  --------------------------------------------------------------------------------
)APL4
----------------------------------------------------------------------------------
LEFT  JOIN SB9010 B9 WITH (NOLOCK) ON B9.D_E_L_E_T_  = ' ' -- Saldos de Fechamentos de Esotque
                                  AND D2_COD         = B9_COD     
					              AND D2_FILIAL      = B9_FILIAL 
					              AND D2_LOCAL       = B9_LOCAL
					              AND SUBSTRING(F2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6)
----------------------------------------------------------------------------------
LEFT JOIN SB2010 B2 WITH (NOLOCK) ON B2.D_E_L_E_T_  = ' ' -- Saldos Atuais
                                 AND D2_COD         = B2_COD   
				                 AND D2_FILIAL      = B2_FILIAL
				                 AND D2_LOCAL       = B2_LOCAL
----------------------------------------------------------------------------------
LEFT JOIN SA3010 A3 WITH (NOLOCK) ON A3.D_E_L_E_T_  = ' ' -- Vendedores
                                 AND F2_VEND1       = A3.A3_COD
----------------------------------------------------------------------------------
LEFT JOIN CT1010 CT1 WITH (NOLOCK) ON CT1.D_E_L_E_T_  = ' ' -- Plano de Contas
                                  AND D2_CONTA        = CT1.CT1_CONTA
----------------------------------------------------------------------------------

)APL
----------------------------------------------------------------------------------------------------------
LEFT JOIN (SELECT
                 C9_FILIAL, C9_PEDIDO, C9_ITEM, C9_NFISCAL, C9_CLIENTE, C9_SEQCAR, C9_CARGA,
				 C9_QTDLIB
           FROM SC9010 C9 WITH (NOLOCK)
		   WHERE C9.D_E_L_E_T_  = ' '
		     AND C9_QTDLIB     <> 0
			 AND C9_NFISCAL    <> ' '
		   GROUP BY C9_FILIAL, C9_PEDIDO, C9_ITEM, C9_NFISCAL, C9_CLIENTE, C9_SEQCAR, C9_CARGA,
					C9_QTDLIB
		  ) SC9
          ON D2_DOC     <> ' '
		 AND C9_FILIAL   = D2_FILIAL
		 AND C9_PEDIDO   = D2_PEDIDO
		 AND C9_ITEM     = D2_ITEMPV
		 AND C9_NFISCAL  = D2_DOC
		 AND C9_CLIENTE  = D2_CLIENTE
		 AND C9_QTDLIB   = D2_QUANT
----------------------------------------------------------------------------------------------------------
--WHERE D2_FILIAL = '02'
--  AND D2_DOC    = '000164271'
--  AND D2_ITEM  IN('01','02') 
)APL10]]></attr>
</Node>
<Edge debugMode="true" fromNode="FATURAMENTO_MARGEM_DE_CONTRIBUICAO:0" guiBendpoints="" guiRouter="Manhattan" id="Edge0" inPort="Port 0 (in)" metadata="Metadata6" outPort="Port 0 (out)" toNode="REFORMAT4:0"/>
</Phase>
<Phase number="1">
<Node enabled="enabled" guiName="Reformat" guiX="299" guiY="81" id="REFORMAT4" type="REFORMAT">
<attr name="transform"><![CDATA[//#CTL2

// Transforms input record into output record.
function integer transform() {
	$out.0.D2_GRUPO = $in.0.D2_GRUPO;
	$out.0.D2_FILIAL = $in.0.D2_FILIAL;
	$out.0.A3_COD = $in.0.A3_COD;
	$out.0.A3_NOME = $in.0.A3_NOME;
	$out.0.B1_COD = $in.0.B1_COD;
	$out.0.B1_CUSTO = $in.0.B1_CUSTO;
	$out.0.Custo = $in.0.Custo;
	$out.0.B1_DESC = $in.0.B1_DESC;
	$out.0.D2_QUANT = $in.0.D2_QUANT;
	$out.0.F2_EMISSAOII = $in.0.F2_EMISSAO;
	$out.0.D2_TOTAL = $in.0.D2_TOTAL;
	$out.0.F2_EMISSAO = $in.0.F2_EMISSAO;
	$out.0.D2_VALICM = $in.0.D2_VALICM;
	$out.0.D2_VALIMP5 = $in.0.D2_VALIMP5;
	$out.0.D2_VALIMP6 = $in.0.D2_VALIMP6;
	$out.0.CLIENTE = $in.0.CLIENTE;
	$out.0.A1_LOJA = $in.0.A1_LOJA;
	$out.0.D2_PEDIDO = $in.0.D2_PEDIDO;
	$out.0.D2_ITEM = $in.0.D2_ITEM;
	$out.0.D2_VALDEV = $in.0.D2_VALDEV;
	$out.0.D2_QTDEDEV = $in.0.D2_QTDEDEV;
	$out.0.DATAATUAL = $in.0.DATAATUAL;
	$out.0.D2_DOC = $in.0.D2_DOC;
	$out.0.D2_DOC2 = $in.0.D2_DOC;
	$out.0.F2_DOC = $in.0.F2_DOC;
	$out.0.D2_DESCON = $in.0.D2_DESCON;
	$out.0.D2_PESO = $in.0.D2_PESO;
	$out.0.A1_GRPTRIB = $in.0.A1_GRPTRIB;
	$out.0.NOTA_FISCAL = $in.0.NOTA_FISCAL;
	$out.0.D2_BASEICM = $in.0.D2_BASEICM;
	$out.0.D2_CF = $in.0.D2_CF;
	$out.0.DESC_CODIGO_FISCAL = $in.0.DESC_CODIGO_FISCAL;
	$out.0.D2_TES = $in.0.D2_TES;
	$out.0.F4_ESTOQUE = $in.0.F4_ESTOQUE;
	$out.0.F4_DUPLIC = $in.0.F4_DUPLIC;
	$out.0.F4_XCTR = $in.0.F4_XCTR;
	$out.0.D2_PRODUTIVIDADE = $in.0.D2_PRODUTIVIDADE;
	$out.0.D1_DTDIGIT = $in.0.D1_DTDIGIT;
	$out.0.D2_VALIPI = $in.0.D2_VALIPI;
	$out.0.A1_COD_CLI = $in.0.A1_COD_CLI;
	$out.0.A1_NOME_CLI = $in.0.A1_NOME_CLI;
	$out.0.F2_EMISSAOIII = $in.0.F2_EMISSAO;
	$out.0.D2_CF_NUM = $in.0.D2_CF_NUM;
	$out.0.F2_FRETE_EXTRA = $in.0.F2_FRETE_EXTRA;
	$out.0.DATA_ULTIMA_NF = $in.0.DATA_ULTIMA_NF;
	$out.0.DATA_PEN_ULTIMA_NF = $in.0.DATA_PEN_ULTIMA_NF;
	$out.0.DATA_ANT_PEN_ULTIMA_NF = $in.0.DATA_ANT_PEN_ULTIMA_NF;
	$out.0.E_ULTIMA_NF = $in.0.E_ULTIMA_NF;
	$out.0.E_PEN_ULTIMA_NF = $in.0.E_PEN_ULTIMA_NF;
	$out.0.E_ANT_PEN_ULTIMA_NF = $in.0.E_ANT_PEN_ULTIMA_NF;
