<attr name="sqlQuery"><![CDATA[SELECT
	  D2_CF_NUM,
	  D2_CF,
	  DESC_CODIGO_FISCAL,
	  D2_TES,
	  F4_ESTOQUE,
	  F4_DUPLIC,
	  F4_XCTR,
	  
	  D2_GRUPO, 
	  D2_FILIAL,
	  A3_COD, 
	  A3_NOME, 
	  B1_COD,
	  B1_CUSTO,
	  CUSTO,
	  B1_DESC, 
	  D2_QUANT, 
	  D2_TOTAL, 
	  F2_EMISSAO,
	  D2_VALICM, 
	  D2_VALIMP5,
	  D2_VALIMP6,
	  D2_DOC,
	  A1_NOME_CLI,
	  A1_COD_CLI,
	  CLIENTE,
	  A1_LOJA, 
	  D2_PEDIDO,
	  D2_ITEM,
	  D2_VALDEV,
	  D2_QTDEDEV,
	  DATAATUAL,
	  F2_DOC,
	  D2_DESCON,
	  D2_PESO,
	  A1_GRPTRIB,
	  NOTA_FISCAL,
	  D2_BASEICM,
	  D2_PRODUTIVIDADE,
	  D1_DTDIGIT,
	  D2_VALIPI,
	  F2_FRETE_EXTRA,
	  SUBSTRING(ULTIMA_NF,1,8)         AS DATA_ULTIMA_NF,
	  SUBSTRING(PEN_ULTIMA_NF,1,8)     AS DATA_PEN_ULTIMA_NF,
	  SUBSTRING(ANT_PEN_ULTIMA_NF,1,8) AS DATA_ANT_PEN_ULTIMA_NF,
	  --------------------------------------------------------------------------------------------------------------------------------------
	  CASE
		  WHEN LTRIM(RTRIM(SUBSTRING(ULTIMA_NF,10,LEN(ULTIMA_NF))))                 = LTRIM(RTRIM(D2_DOC + '-' + CLIENTE)) THEN 'Sim'
		  ELSE 'Nao'
	  END AS E_ULTIMA_NF,
	  --------------------------------------------------------------------------------------------------------------------------------------
	  CASE
		  WHEN LTRIM(RTRIM(SUBSTRING(PEN_ULTIMA_NF,10,LEN(PEN_ULTIMA_NF))))         = LTRIM(RTRIM(D2_DOC + '-' + CLIENTE)) THEN 'Sim'
		  ELSE 'Nao'
	  END AS E_PEN_ULTIMA_NF,
	  --------------------------------------------------------------------------------------------------------------------------------------
	  CASE
		  WHEN LTRIM(RTRIM(SUBSTRING(ANT_PEN_ULTIMA_NF,10,LEN(ANT_PEN_ULTIMA_NF)))) = LTRIM(RTRIM(D2_DOC + '-' + CLIENTE)) THEN 'Sim'
		  ELSE 'Nao'
	  END AS E_ANT_PEN_ULTIMA_NF
	  --------------------------------------------------------------------------------------------------------------------------------------
FROM(
SELECT
	  --SUM(B1_CUSTO) AS B1_CUSTO,
	  --SUM(CUSTO) AS CUSTO,
	  --SUM(1) AS SUM_
	  --/*
	  D2_CF_NUM,
	  D2_CF,
	  DESC_CODIGO_FISCAL,
	  D2_TES,
	  F4_ESTOQUE,
	  F4_DUPLIC,
	  F4_XCTR,
	  /*
	  ' ' AS ULTIMA_NF,
	  ' ' AS PEN_ULTIMA_NF,
	  ' ' AS ANT_PEN_ULTIMA_NF,
	  */
	  -----------------------------------------------------------------------------------------------------------------------------------------------------
	  (SELECT CAMPO
	   FROM(
	   SELECT
	         D2_EMISSAO,
			 ROW_NUMBER() OVER (ORDER BY D2_EMISSAO DESC) AS N_LINHA,
			 -----------------------------------------------------------------------------------------
			 CASE
				 WHEN F2_AVALIST  = ' ' THEN D2_EMISSAO + '-' + D2_DOC + '-' + D2_CLIENTE
				 ELSE D2_EMISSAO + '-' + D2_DOC + '-' + F2_AVALIST
			 END AS CAMPO,
			 -----------------------------------------------------------------------------------------
			 CASE
				 WHEN F2_AVALIST  = ' ' THEN D2_CLIENTE
				 ELSE F2_AVALIST
			 END AS CLIENTE_2
			 -----------------------------------------------------------------------------------------

	   FROM SD2010 D2, SF4010 F4, SF2010 F2
       WHERE D2.D_E_L_E_T_ = ' ' AND F4.D_E_L_E_T_ = ' ' AND F2.D_E_L_E_T_ = ' '
	     AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE = 'S' AND F4_DUPLIC = 'S')                                              OR 
		                                   (F4_ESTOQUE = 'S' AND F4_XCTR   = 'S')                                              OR 
										   (F4_ESTOQUE = 'N' AND F4_DUPLIC = 'S' AND D2.D2_CF IN('5101','5924','6101','6924')) OR
										   (F4_ESTOQUE = 'S' AND F4_DUPLIC = 'N' AND D2.D2_CF IN('5101','5924','6101','6924'))
 										  )
         AND APL.D2_CF        IN('OK','5101','5924','6101','6924')
		 AND D2_GRUPO NOT IN('0011','0021')
		 AND SUBSTRING(D2.D2_EMISSAO,1,4) >= '2022'
		 AND D2_DOC = F2_DOC    AND D2_SERIE = F2_SERIE AND D2_CLIENTE = F2_CLIENTE AND D2_LOJA = F2_LOJA AND D2_FILIAL = F2_FILIAL
		 AND CASE WHEN F2_AVALIST  = ' ' THEN D2_CLIENTE ELSE F2_AVALIST END = APL.CLIENTE
	   
	   GROUP BY D2_EMISSAO, 
	            CASE WHEN F2_AVALIST  = ' ' THEN D2_EMISSAO + '-' + D2_DOC + '-' + D2_CLIENTE
				     ELSE D2_EMISSAO + '-' + D2_DOC + '-' + F2_AVALIST END,
				CASE WHEN F2_AVALIST  = ' ' THEN D2_CLIENTE
				     ELSE F2_AVALIST END
	   )SUB 
	   WHERE SUB.N_LINHA = 1 
	   ) AS ULTIMA_NF,
	  -----------------------------------------------------------------------------------------------------------------------------------------------------
	  (SELECT CAMPO
	   FROM(
	   SELECT
	         D2_EMISSAO,
			 ROW_NUMBER() OVER (ORDER BY D2_EMISSAO DESC) AS N_LINHA,
			 -----------------------------------------------------------------------------------------
			 CASE
				 WHEN F2_AVALIST  = ' ' THEN D2_EMISSAO + '-' + D2_DOC + '-' + D2_CLIENTE
				 ELSE D2_EMISSAO + '-' + D2_DOC + '-' + F2_AVALIST
			 END AS CAMPO,
			 -----------------------------------------------------------------------------------------
			 CASE
				 WHEN F2_AVALIST  = ' ' THEN D2_CLIENTE
				 ELSE F2_AVALIST
			 END AS CLIENTE_2
			 -----------------------------------------------------------------------------------------

	   FROM SD2010 D2, SF4010 F4, SF2010 F2
       WHERE D2.D_E_L_E_T_ = ' ' AND F4.D_E_L_E_T_ = ' ' AND F2.D_E_L_E_T_ = ' '
	     AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE = 'S' AND F4_DUPLIC = 'S')                                              OR 
		                                   (F4_ESTOQUE = 'S' AND F4_XCTR   = 'S')                                              OR 
										   (F4_ESTOQUE = 'N' AND F4_DUPLIC = 'S' AND D2.D2_CF IN('5101','5924','6101','6924')) OR
										   (F4_ESTOQUE = 'S' AND F4_DUPLIC = 'N' AND D2.D2_CF IN('5101','5924','6101','6924'))
 										  )
		 AND D2_CF        IN('OK','5101','5924','6101','6924')
		 AND D2_GRUPO NOT IN('0011','0021')
		 AND SUBSTRING(D2.D2_EMISSAO,1,4) >= '2022'
		 AND D2_DOC = F2_DOC    AND D2_SERIE = F2_SERIE AND D2_CLIENTE = F2_CLIENTE AND D2_LOJA = F2_LOJA AND D2_FILIAL = F2_FILIAL
		 AND CASE WHEN F2_AVALIST  = ' ' THEN D2_CLIENTE ELSE F2_AVALIST END = APL.CLIENTE
	   
	   GROUP BY D2_EMISSAO, 
	            CASE WHEN F2_AVALIST  = ' ' THEN D2_EMISSAO + '-' + D2_DOC + '-' + D2_CLIENTE
				     ELSE D2_EMISSAO + '-' + D2_DOC + '-' + F2_AVALIST END,
				CASE WHEN F2_AVALIST  = ' ' THEN D2_CLIENTE
				     ELSE F2_AVALIST END
	   )SUB 
	   WHERE SUB.N_LINHA = 2 
	   ) AS PEN_ULTIMA_NF,
	  -----------------------------------------------------------------------------------------------------------------------------------------------------
	  (SELECT CAMPO
	   FROM(
	   SELECT
	         D2_EMISSAO,
			 ROW_NUMBER() OVER (ORDER BY D2_EMISSAO DESC) AS N_LINHA,
			 -----------------------------------------------------------------------------------------
			 CASE
				 WHEN F2_AVALIST  = ' ' THEN D2_EMISSAO + '-' + D2_DOC + '-' + D2_CLIENTE
				 ELSE D2_EMISSAO + '-' + D2_DOC + '-' + F2_AVALIST
			 END AS CAMPO,
			 -----------------------------------------------------------------------------------------
			 CASE
				 WHEN F2_AVALIST  = ' ' THEN D2_CLIENTE
				 ELSE F2_AVALIST
			 END AS CLIENTE_2
			 -----------------------------------------------------------------------------------------

	   FROM SD2010 D2, SF4010 F4, SF2010 F2
       WHERE D2.D_E_L_E_T_ = ' ' AND F4.D_E_L_E_T_ = ' ' AND F2.D_E_L_E_T_ = ' '
	     AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE = 'S' AND F4_DUPLIC = 'S')                                              OR 
		                                   (F4_ESTOQUE = 'S' AND F4_XCTR   = 'S')                                              OR 
										   (F4_ESTOQUE = 'N' AND F4_DUPLIC = 'S' AND D2.D2_CF IN('5101','5924','6101','6924')) OR
										   (F4_ESTOQUE = 'S' AND F4_DUPLIC = 'N' AND D2.D2_CF IN('5101','5924','6101','6924'))
 										  )
		 AND D2_CF        IN('OK','5101','5924','6101','6924')
		 AND D2_GRUPO NOT IN('0011','0021')
		 AND SUBSTRING(D2.D2_EMISSAO,1,4) >= '2022'
		 AND D2_DOC = F2_DOC    AND D2_SERIE = F2_SERIE AND D2_CLIENTE = F2_CLIENTE AND D2_LOJA = F2_LOJA AND D2_FILIAL = F2_FILIAL
		 AND CASE WHEN F2_AVALIST  = ' ' THEN D2_CLIENTE ELSE F2_AVALIST END = APL.CLIENTE
	   
	   GROUP BY D2_EMISSAO, 
	            CASE WHEN F2_AVALIST  = ' ' THEN D2_EMISSAO + '-' + D2_DOC + '-' + D2_CLIENTE
				     ELSE D2_EMISSAO + '-' + D2_DOC + '-' + F2_AVALIST END,
				CASE WHEN F2_AVALIST  = ' ' THEN D2_CLIENTE
				     ELSE F2_AVALIST END
	   )SUB 
	   WHERE SUB.N_LINHA = 3 
	   ) AS ANT_PEN_ULTIMA_NF,
	  -----------------------------------------------------------------------------------------------------------------------------------------------------
	  D2_GRUPO, 
	  D2_FILIAL,
	  A3_COD, 
	  A3_NOME, 
	  B1_COD,
	  B1_CUSTO,
	  CUSTO,
	  B1_DESC, 
	  D2_QUANT, 
	  D2_TOTAL, 
	  F2_EMISSAO,
	  D2_VALICM, 
	  D2_VALIMP5,
	  D2_VALIMP6,
	  D2_DOC,
	  --------------------------------------------------------
	  ISNULL(
	  (
	   SELECT MAX(A1_NOME) AS A1_NOME
	   FROM SA1010 ZZ
	   WHERE ZZ.D_E_L_E_T_ = ' '
	     AND ZZ.A1_COD     = APL.CLIENTE
	  )
	  ,'0 - Cliente nao encontrado') AS A1_NOME_CLI,
	  --------------------------------------------------------
	  CLIENTE AS A1_COD_CLI,
	  CLIENTE,
	  A1_LOJA, 
	  D2_PEDIDO,
	  D2_ITEM,
	  D2_VALDEV,
	  D2_QTDEDEV,
	  DATAATUAL,
	  F2_DOC,
	  D2_DESCON,
	  D2_PESO,
	  A1_GRPTRIB,
	  NOTA_FISCAL,
	  D2_BASEICM,
	  D2_PRODUTIVIDADE,
	  D1_DTDIGIT,
	  D2_VALIPI,
	  F2_FRETE_EXTRA
	  --*/
FROM(

SELECT	--Faturamento com TES que movimenta Estoque e Financeiro
	  D2_CF AS D2_CF_NUM,
	  'OK' AS D2_CF,
	  'OK' AS DESC_CODIGO_FISCAL,D2_TES,F4_ESTOQUE,F4_DUPLIC,F4_XCTR,
	  D2_GRUPO,D2_FILIAL,
	  ISNULL(A3_COD,'XXXXXX') AS A3_COD,ISNULL(A3_NOME,'Sem Vendedor') AS A3_NOME,
	  B1_COD,
	  --/*
	  -------------------------------------------------------------------
	   CASE
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Tem fechamento SB9
	  	  THEN (D2_CUSTO1/D2_QUANT)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN (B9_CM1)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
		   AND D2_CUSTO1   = 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN B2_CM1	   	  
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Tem fechamento SB9
	  	  THEN ((D2_CUSTO1/D2_QUANT)+((D2_CUSTO1/D2_QUANT)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB = '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN ((B9_CM1)+((B9_CM1)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1   = 0
		   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN (B2_CM1+(B2_CM1*0.07))
	  	  ----------------------------
	  	  ELSE 0
	   END AS B1_CUSTO,
	  -------------------------------------------------------------------
	  CASE
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN (D2_CUSTO1/D2_QUANT)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND D2_CUSTO1   = 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN (B1_CUSTO)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN B1_CUSTO
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN ((D2_CUSTO1/D2_QUANT)+((D2_CUSTO1/D2_QUANT)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB = '104' 
	  	   AND D2_CUSTO1  = 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN ((B1_CUSTO)+((B1_CUSTO)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN (B1_CUSTO+(B1_CUSTO*0.07))
	  	  ----------------------------
	  	  ELSE 0
	  END AS CUSTO,
	  -------------------------------------------------------------------
	  --*/
	  B1_DESC,D2_QUANT,D2_TOTAL,F2_EMISSAO,D2_VALICM,D2_VALIMP5,D2_VALIMP6,D2_DOC,CLIENTE,A1_LOJA,D2_PEDIDO,D2_ITEM,D2_VALDEV,D2_QTDEDEV,DATAATUAL,F2_DOC,D2_DESCON,D2_PESO,A1_GRPTRIB,NOTA_FISCAL,D2_BASEICM,
	  D2_PRODUTIVIDADE,
	  NULL AS D1_DTDIGIT,
	  D2_VALIPI,
	  (F2_FRETE/D2_QTD_ITEM) AS F2_FRETE_EXTRA
FROM(
SELECT --| Venda |
	  D2_GRUPO, 
	  D2_FILIAL, 
	  --A3_COD, 
	  --A3_NOME, 
	  B1_COD,
	  B1_DESC, 
	  D2_QUANT, 
	  D2_TOTAL, 
	  F2_EMISSAO, 
	  D2_VALICM, 
	  D2_VALIMP5, 
	  D2_VALIMP6, 
	  D2_DOC,
	  -------------------------------------------------------------------
	  CASE
	  	 WHEN F2_AVALIST  = ' ' THEN A1_COD
	  	 WHEN F2_AVALIST <> ' ' THEN F2_AVALIST
	  	 ELSE 'ERRO'
	  END AS CLIENTE, 
	  -------------------------------------------------------------------
	  A1_LOJA, 
	  D2_PEDIDO, 
	  D2_ITEM,
	  D2_VALDEV,
	  D2_QTDEDEV,
	  GETDATE() AS DATAATUAL,
	  F2_DOC,
	  D2_DESCON,
	  D2_PESO,
	  A1_GRPTRIB,
	  F2_DOC AS NOTA_FISCAL,
	  D2_BASEICM,
	  D2_COD,D2_LOCAL,D2_CUSTO1,B1_CUSTO,D2_EMISSAO,D2_TES,F4_ESTOQUE,F4_DUPLIC,F4_XCTR,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  CASE
		  WHEN (SELECT MAX(SUBSTRING(C5.C5_EMISSAO,1,6))
		        FROM SC5010 C5
				WHERE C5.D_E_L_E_T_  = ' '
				  AND C5.C5_FILIAL   = D2.D2_FILIAL
				  AND C5.C5_NUM      = D2.D2_PEDIDO
			   ) >= SUBSTRING(D2_EMISSAO,1,6) THEN 'Mesmo mes'
		  ElSE 'Outro mes'
	  END AS D2_PRODUTIVIDADE,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  D2_VALIPI,
	  D2_CF,
	  F2_VEND1,
	  F2_FRETE,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  (SELECT COUNT(*)
	   FROM SD2010 A
	   WHERE A.D_E_L_E_T_ = ' '
	     AND A.D2_FILIAL  = D2.D2_FILIAL 
		 AND A.D2_DOC     =	D2.D2_DOC    
		 AND A.D2_SERIE   =	D2.D2_SERIE  
		 AND A.D2_CLIENTE =	D2.D2_CLIENTE
		 AND A.D2_LOJA    = D2.D2_LOJA ) AS D2_QTD_ITEM
	  -------------------------------------------------------------------------------------------------------------------------------------------------

FROM SD2010 D2, SF4010 F4, SF2010 F2, /*SA3010 A3,*/ SB1010 B1, SA1010 A1
WHERE D2.D_E_L_E_T_ = ' ' AND F4.D_E_L_E_T_ = ' ' AND F2.D_E_L_E_T_ = ' ' /*AND A3.D_E_L_E_T_ = ' '*/ AND B1.D_E_L_E_T_ = ' '
  --------------------------------------------------------------------------------
  AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE   = 'S' AND F4_DUPLIC = 'S') OR (F4_ESTOQUE = 'S' AND F4_XCTR = 'S'))   
  --AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE = 'N' AND F4_DUPLIC = 'S'))
  --AND D2_TES      = F4_CODIGO AND ((F4_DUPLIC = 'S') OR (F4_XCTR = 'S')) 
  AND D2_DOC      = F2_DOC    AND D2_SERIE = F2_SERIE AND D2_CLIENTE = F2_CLIENTE AND D2_LOJA = F2_LOJA AND D2_FILIAL = F2_FILIAL
  AND D2_CLIENTE  = A1_COD    AND D2_LOJA  = A1_LOJA
  --AND F2_VEND1    = A3_COD 
  AND D2_COD      = B1_COD
  --------------------------------------------------------------------------------  
  AND SUBSTRING(D2_EMISSAO,1,4) >= '2022'--'2015'
  --AND D2_EMISSAO < '20200304'
  AND F2_TIPO     = 'N'
  AND D2_CF NOT IN('7949') 
  AND D2_QTDEDEV  = 0
  --------------------------------------------------------------------------------
  /*
  AND D2_CUSTO1  <> 0  
  AND F2_AVALIST  = ' ' 
  AND A1_GRPTRIB <> '104'  
  AND EXISTS (SELECT B9_COD 
              FROM SB9010 
              WHERE SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) 
                AND D2_FILIAL                 = B9_FILIAL 
                AND D2_LOCAL                  = B9_LOCAL 
                AND D2_COD                    = B9_COD )
  */
  --------------------------------------------------------------------------------
)APL1
----------------------------------------------------------------------------------
LEFT  JOIN SB9010 B9 ON B9.D_E_L_E_T_  = ' ' -- Saldos de Fechamentos de Esotque
                    AND D2_COD         = B9_COD     
					AND D2_FILIAL      = B9_FILIAL 
					AND D2_LOCAL       = B9_LOCAL
					AND SUBSTRING(F2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6)
----------------------------------------------------------------------------------
LEFT JOIN SB2010 B2 ON B2.D_E_L_E_T_  = ' ' -- Saldos Atuais
                   AND D2_COD         = B2_COD   
				   AND D2_FILIAL      = B2_FILIAL
				   AND D2_LOCAL       = B2_LOCAL
----------------------------------------------------------------------------------
LEFT JOIN SA3010 A3 ON A3.D_E_L_E_T_  = ' ' -- Vendedores
                   AND F2_VEND1       = A3.A3_COD
----------------------------------------------------------------------------------

--------------------
UNION
--------------------

SELECT	--Devolução com TES que movimenta Estoque e Financeiro
	  D2_CF AS D2_CF_NUM,
	  'OK' AS D2_CF,
	  'OK' AS DESC_CODIGO_FISCAL,D2_TES,F4_ESTOQUE,F4_DUPLIC,F4_XCTR,
	  D2_GRUPO,D2_FILIAL,
	  ISNULL(A3_COD,'XXXXXX') AS A3_COD,ISNULL(A3_NOME,'Sem Vendedor') AS A3_NOME,
	  B1_COD,
	  --/*
	   -------------------------------------------------------------------
	   CASE
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Tem fechamento SB9
	  	  THEN (D2_CUSTO1/D2_QUANT)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN (B9_CM1)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
		   AND D2_CUSTO1   = 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN B2_CM1	   	  
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Tem fechamento SB9
	  	  THEN ((D2_CUSTO1/D2_QUANT)+((D2_CUSTO1/D2_QUANT)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB = '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN ((B9_CM1)+((B9_CM1)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1   = 0
		   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN (B2_CM1+(B2_CM1*0.07))
	  	  ----------------------------
	  	  ELSE 0
	   END AS B1_CUSTO,
	  -------------------------------------------------------------------
	   CASE
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB <> '104' 
	   	   AND D2_CUSTO1  <> 0
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	   	  THEN (D2_CUSTO1/D2_QUANT)
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB <> '104' 
	   	   AND D2_CUSTO1   = 0
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	   	  THEN (B1_CUSTO)
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB <> '104' 
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	   	  THEN B1_CUSTO
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB  = '104' 
	   	   AND D2_CUSTO1  <> 0
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	   	  THEN ((D2_CUSTO1/D2_QUANT)+((D2_CUSTO1/D2_QUANT)*0.07))
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB = '104' 
	   	   AND D2_CUSTO1  = 0
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	   	  THEN (B1_CUSTO)+((B1_CUSTO)*0.07)
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB = '104' 
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	   	  THEN (B1_CUSTO+(B1_CUSTO*0.07))
	   	  ----------------------------
	   	  ELSE 0
	   END AS CUSTO,
	   -------------------------------------------------------------------
	   --*/
	  B1_DESC,D2_QUANT,D2_TOTAL,F2_EMISSAO,D2_VALICM,D2_VALIMP5,D2_VALIMP6,D2_DOC,CLIENTE,A1_LOJA,D2_PEDIDO,D2_ITEM,D2_VALDEV,D2_QTDEDEV,DATAATUAL,F2_DOC,D2_DESCON,D2_PESO,A1_GRPTRIB,NOTA_FISCAL,D2_BASEICM,
	  D2_PRODUTIVIDADE,
	  D1_DTDIGIT,
	  D2_VALIPI,
	  (F2_FRETE/D2_QTD_ITEM) AS F2_FRETE_EXTRA
FROM(
SELECT --| Devolução |
	   D2_GRUPO, 
	   D2_FILIAL, 
	   --A3_COD, 
	   --A3_NOME, 
	   B1_COD,
	   B1_DESC, 
	   D2_QUANT, 
	   D2_TOTAL, 
	   F2_EMISSAO,
	   (D2_VALICM-D1_VALICM)   AS D2_VALICM, 
	   (D2_VALIMP5-D1_VALIMP5) AS D2_VALIMP5, 
	   (D2_VALIMP6-D1_VALIMP6) AS D2_VALIMP6, 
	   D2_DOC, 
	   -------------------------------------------------------------------
	   CASE
	   	  WHEN F2_AVALIST  = ' ' THEN A1_COD
	   	  WHEN F2_AVALIST <> ' ' THEN F2_AVALIST
	   	  ELSE 'ERRO'
	   END AS CLIENTE, 
	   -------------------------------------------------------------------
	   A1_LOJA, 
	   D2_PEDIDO, 
	   D2_ITEM,
	   (D1_TOTAL-D1_VALDESC)AS D2_VALDEV,
	   D2_QTDEDEV,
	   GETDATE() AS DATAATUAL,
	   F2_DOC,
	   D2_DESCON,
	   D2_PESO,
	   A1_GRPTRIB,
	   F2_DOC AS NOTA_FISCAL,
	   D2_BASEICM,
	   D2_COD,D2_LOCAL,D2_CUSTO1,B1_CUSTO,D2_EMISSAO,D2_TES,F4_ESTOQUE,F4_DUPLIC,F4_XCTR,
	   -------------------------------------------------------------------------------------------------------------------------------------------------
	  CASE
		  WHEN (SELECT MAX(SUBSTRING(C5.C5_EMISSAO,1,6))
		        FROM SC5010 C5
				WHERE C5.D_E_L_E_T_  = ' '
				  AND C5.C5_FILIAL   = D2.D2_FILIAL
				  AND C5.C5_NUM      = D2.D2_PEDIDO
			   ) >= SUBSTRING(D2_EMISSAO,1,6) THEN 'Mesmo mes'
		  ElSE 'Outro mes'
	  END AS D2_PRODUTIVIDADE,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  D1_DTDIGIT,
	  D2_VALIPI,
	  D2_CF,
	  F2_VEND1,
	  F2_FRETE,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  (SELECT COUNT(*)
	   FROM SD2010 A
	   WHERE A.D_E_L_E_T_ = ' '
	     AND A.D2_FILIAL  = D2.D2_FILIAL 
		 AND A.D2_DOC     =	D2.D2_DOC    
		 AND A.D2_SERIE   =	D2.D2_SERIE  
		 AND A.D2_CLIENTE =	D2.D2_CLIENTE
		 AND A.D2_LOJA    = D2.D2_LOJA ) AS D2_QTD_ITEM
	  -------------------------------------------------------------------------------------------------------------------------------------------------

FROM SD2010 D2, SF4010 F4, SF2010 F2, /*SA3010 A3,*/ SB1010 B1, SA1010 A1, SD1010 D1
WHERE D2.D_E_L_E_T_  = ' ' AND F4.D_E_L_E_T_  = ' ' AND F2.D_E_L_E_T_  = ' ' /*AND A3.D_E_L_E_T_  = ' '*/ AND B1.D_E_L_E_T_  = ' ' AND D1.D_E_L_E_T_  = ' '
  --------------------------------------------------------------------------------
  AND D1_FORNECE  = D2_CLIENTE AND D1_FILIAL = D2_FILIAL AND D1_COD = D2_COD AND D1_NFORI = D2_DOC AND D1_SERIORI = D2_SERIE AND D1_LOJA = D2_LOJA 
  AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE   = 'S' AND F4_DUPLIC = 'S') OR (F4_ESTOQUE = 'S' AND F4_XCTR = 'S'))   
  --AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE = 'N' AND F4_DUPLIC = 'S'))
  --AND D2_TES      = F4_CODIGO  AND ((F4_DUPLIC = 'S') OR (F4_XCTR = 'S')) 
  AND D2_DOC      = F2_DOC     AND D2_SERIE = F2_SERIE AND D2_CLIENTE = F2_CLIENTE AND D2_LOJA = F2_LOJA AND D2_FILIAL = F2_FILIAL
  AND D2_CLIENTE  = A1_COD     AND D2_LOJA = A1_LOJA
  --AND F2_VEND1    = A3_COD 
  AND D2_COD      = B1_COD
  --------------------------------------------------------------------------------
  AND SUBSTRING(D2_EMISSAO,1,4) >= '2022'--'2015'
  --AND D2_EMISSAO < '20200304'
  AND F2_TIPO     = 'N'
  AND D2_CF NOT IN('7949')
  AND D2_QTDEDEV <> 0 
  --------------------------------------------------------------------------------
  /*
  AND D2_CUSTO1  <> 0  
  AND F2_AVALIST  = ' '       
  AND A1_GRPTRIB <> '104'      
  AND EXISTS (SELECT B9_COD 
              FROM SB9010 
              WHERE SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) 
                AND D2_FILIAL                 = B9_FILIAL 
                AND D2_LOCAL                  = B9_LOCAL 
                AND D2_COD                    = B9_COD )
  */
  --------------------------------------------------------------------------------
)APL2
----------------------------------------------------------------------------------
LEFT  JOIN SB9010 B9 ON B9.D_E_L_E_T_  = ' ' -- Saldos de Fechamentos de Esotque
                    AND D2_COD         = B9_COD     
					AND D2_FILIAL      = B9_FILIAL 
					AND D2_LOCAL       = B9_LOCAL
					AND SUBSTRING(F2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6)
----------------------------------------------------------------------------------
LEFT JOIN SB2010 B2 ON B2.D_E_L_E_T_  = ' ' -- Saldos Atuais
                   AND D2_COD         = B2_COD   
				   AND D2_FILIAL      = B2_FILIAL
				   AND D2_LOCAL       = B2_LOCAL
----------------------------------------------------------------------------------
LEFT JOIN SA3010 A3 ON A3.D_E_L_E_T_  = ' ' -- Vendedores
                   AND F2_VEND1       = A3.A3_COD
----------------------------------------------------------------------------------

--------------------
UNION
--------------------

SELECT	--Faturamento com TES que movimenta somente Financeiro
	  D2_CF AS D2_CF_NUM,
	  D2_CF,DESC_CODIGO_FISCAL,D2_TES,F4_ESTOQUE,F4_DUPLIC,F4_XCTR,
	  D2_GRUPO,D2_FILIAL,
	  ISNULL(A3_COD,'XXXXXX') AS A3_COD,ISNULL(A3_NOME,'Sem Vendedor') AS A3_NOME,
	  B1_COD,
	  --/*
	  -------------------------------------------------------------------
	   CASE
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Tem fechamento SB9
	  	  THEN (D2_CUSTO1/D2_QUANT)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN (B9_CM1)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
		   AND D2_CUSTO1   = 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN B2_CM1	   	  
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Tem fechamento SB9
	  	  THEN ((D2_CUSTO1/D2_QUANT)+((D2_CUSTO1/D2_QUANT)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB = '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN ((B9_CM1)+((B9_CM1)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1   = 0
		   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN (B2_CM1+(B2_CM1*0.07))
	  	  ----------------------------
	  	  ELSE 0
	   END AS B1_CUSTO,
	  -------------------------------------------------------------------
	  CASE
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN (D2_CUSTO1/D2_QUANT)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND D2_CUSTO1   = 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN (B1_CUSTO)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN B1_CUSTO
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN ((D2_CUSTO1/D2_QUANT)+((D2_CUSTO1/D2_QUANT)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB = '104' 
	  	   AND D2_CUSTO1  = 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9 
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN ((B1_CUSTO)+((B1_CUSTO)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN (B1_CUSTO+(B1_CUSTO*0.07))
	  	  ----------------------------
	  	  ELSE 0
	  END AS CUSTO,
	  -------------------------------------------------------------------
	  --*/
	  B1_DESC,D2_QUANT,D2_TOTAL,F2_EMISSAO,D2_VALICM,D2_VALIMP5,D2_VALIMP6,D2_DOC,CLIENTE,A1_LOJA,D2_PEDIDO,D2_ITEM,D2_VALDEV,D2_QTDEDEV,DATAATUAL,F2_DOC,D2_DESCON,D2_PESO,A1_GRPTRIB,NOTA_FISCAL,D2_BASEICM,
	  D2_PRODUTIVIDADE,
	  NULL AS D1_DTDIGIT,
	  D2_VALIPI,
	  (F2_FRETE/D2_QTD_ITEM) AS F2_FRETE_EXTRA
FROM(
SELECT --| Venda |
	  D2_GRUPO, 
	  D2_FILIAL, 
	  --A3_COD, 
	  --A3_NOME, 
	  B1_COD,
	  B1_DESC, 
	  D2_QUANT, 
	  D2_TOTAL, 
	  F2_EMISSAO, 
	  D2_VALICM, 
	  D2_VALIMP5, 
	  D2_VALIMP6, 
	  D2_DOC,
	  -------------------------------------------------------------------
	  CASE
	  	 WHEN F2_AVALIST  = ' ' THEN A1_COD
	  	 WHEN F2_AVALIST <> ' ' THEN F2_AVALIST
	  	 ELSE 'ERRO'
	  END AS CLIENTE, 
	  -------------------------------------------------------------------
	  A1_LOJA, 
	  D2_PEDIDO, 
	  D2_ITEM,
	  D2_VALDEV,
	  D2_QTDEDEV,
	  GETDATE() AS DATAATUAL,
	  F2_DOC,
	  D2_DESCON,
	  D2_PESO,
	  A1_GRPTRIB,
	  F2_DOC AS NOTA_FISCAL,
	  D2_BASEICM,
	  D2_COD,D2_LOCAL,D2_CUSTO1,B1_CUSTO,D2_EMISSAO,D2_TES,F4_ESTOQUE,F4_DUPLIC,F4_XCTR,
	  D2_CF,
	   (SELECT X5_DESCRI                             
	    FROM SX5010                                  
	    WHERE D_E_L_E_T_ = ' '                      
	   	  AND D2.D2_FILIAL = X5_FILIAL              
	   	  AND X5_TABELA = '13'                       
	   	  AND X5_CHAVE = D2.D2_CF)                  AS DESC_CODIGO_FISCAL,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  CASE
		  WHEN (SELECT MAX(SUBSTRING(C5.C5_EMISSAO,1,6))
		        FROM SC5010 C5
				WHERE C5.D_E_L_E_T_  = ' '
				  AND C5.C5_FILIAL   = D2.D2_FILIAL
				  AND C5.C5_NUM      = D2.D2_PEDIDO
			   ) >= SUBSTRING(D2_EMISSAO,1,6) THEN 'Mesmo mes'
		  ElSE 'Outro mes'
	  END AS D2_PRODUTIVIDADE,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  D2_VALIPI,
	  F2_VEND1,
	  F2_FRETE,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  (SELECT COUNT(*)
	   FROM SD2010 A
	   WHERE A.D_E_L_E_T_ = ' '
	     AND A.D2_FILIAL  = D2.D2_FILIAL 
		 AND A.D2_DOC     =	D2.D2_DOC    
		 AND A.D2_SERIE   =	D2.D2_SERIE  
		 AND A.D2_CLIENTE =	D2.D2_CLIENTE
		 AND A.D2_LOJA    = D2.D2_LOJA ) AS D2_QTD_ITEM
	  -------------------------------------------------------------------------------------------------------------------------------------------------

FROM SD2010 D2, SF4010 F4, SF2010 F2, /*SA3010 A3,*/ SB1010 B1, SA1010 A1
WHERE D2.D_E_L_E_T_ = ' ' AND F4.D_E_L_E_T_ = ' ' AND F2.D_E_L_E_T_ = ' ' /*AND A3.D_E_L_E_T_ = ' '*/ AND B1.D_E_L_E_T_ = ' '
  --------------------------------------------------------------------------------
  --AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE   = 'S' AND F4_DUPLIC = 'S') OR (F4_ESTOQUE = 'S' AND F4_XCTR = 'S'))   
  AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE = 'N' AND F4_DUPLIC = 'S')OR(F4_ESTOQUE = 'S' AND F4_DUPLIC = 'N'))
  --AND D2_TES      = F4_CODIGO AND ((F4_DUPLIC = 'S') OR (F4_XCTR = 'S')) 
  AND D2_DOC      = F2_DOC    AND D2_SERIE = F2_SERIE AND D2_CLIENTE = F2_CLIENTE AND D2_LOJA = F2_LOJA AND D2_FILIAL = F2_FILIAL
  AND D2_CLIENTE  = A1_COD    AND D2_LOJA  = A1_LOJA
  --AND F2_VEND1    = A3_COD 
  AND D2_COD      = B1_COD
  --------------------------------------------------------------------------------  
  AND SUBSTRING(D2_EMISSAO,1,4) >= '2022'--'2015'
  --AND D2_EMISSAO < '20200304'
  AND F2_TIPO     = 'N' 
  AND D2_CF NOT IN('7949')
  AND D2_QTDEDEV  = 0
  --------------------------------------------------------------------------------
  /*
  AND D2_CUSTO1  <> 0  
  AND F2_AVALIST  = ' ' 
  AND A1_GRPTRIB <> '104'  
  AND EXISTS (SELECT B9_COD 
              FROM SB9010 
              WHERE SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) 
                AND D2_FILIAL                 = B9_FILIAL 
                AND D2_LOCAL                  = B9_LOCAL 
                AND D2_COD                    = B9_COD )
  */
  --------------------------------------------------------------------------------
)APL3
----------------------------------------------------------------------------------
LEFT  JOIN SB9010 B9 ON B9.D_E_L_E_T_  = ' ' -- Saldos de Fechamentos de Esotque
                    AND D2_COD         = B9_COD     
					AND D2_FILIAL      = B9_FILIAL 
					AND D2_LOCAL       = B9_LOCAL
					AND SUBSTRING(F2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6)
----------------------------------------------------------------------------------
LEFT JOIN SB2010 B2 ON B2.D_E_L_E_T_  = ' ' -- Saldos Atuais
                   AND D2_COD         = B2_COD   
				   AND D2_FILIAL      = B2_FILIAL
				   AND D2_LOCAL       = B2_LOCAL
----------------------------------------------------------------------------------
LEFT JOIN SA3010 A3 ON A3.D_E_L_E_T_  = ' ' -- Vendedores
                   AND F2_VEND1       = A3.A3_COD
----------------------------------------------------------------------------------

--------------------
UNION
--------------------

SELECT	--Devolução com TES de saida que movimenta somente Financeiro
	  D2_CF AS D2_CF_NUM,
	  D2_CF,DESC_CODIGO_FISCAL,D2_TES,F4_ESTOQUE,F4_DUPLIC,F4_XCTR,
	  D2_GRUPO,D2_FILIAL,
	  ISNULL(A3_COD,'XXXXXX') AS A3_COD,ISNULL(A3_NOME,'Sem Vendedor') AS A3_NOME,
	  B1_COD,
	  --/*
	   -------------------------------------------------------------------
	   CASE
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Tem fechamento SB9
	  	  THEN (D2_CUSTO1/D2_QUANT)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN (B9_CM1)
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB <> '104' 
		   AND D2_CUSTO1   = 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN B2_CM1	   	  
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1  <> 0
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Tem fechamento SB9
	  	  THEN ((D2_CUSTO1/D2_QUANT)+((D2_CUSTO1/D2_QUANT)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB = '104' 
	  	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	  	  THEN ((B9_CM1)+((B9_CM1)*0.07))
	  	  ----------------------------
	  	  WHEN A1_GRPTRIB  = '104' 
	  	   AND D2_CUSTO1   = 0
		   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	  	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	  	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	  	  THEN (B2_CM1+(B2_CM1*0.07))
	  	  ----------------------------
	  	  ELSE 0
	   END AS B1_CUSTO,
	  -------------------------------------------------------------------
	   CASE
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB <> '104' 
	   	   AND D2_CUSTO1  <> 0
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	   	  THEN (D2_CUSTO1/D2_QUANT)
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB <> '104' 
	   	   AND D2_CUSTO1   = 0
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	   	  THEN (B1_CUSTO)
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB <> '104' 
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	   	  THEN B1_CUSTO
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB  = '104' 
	   	   AND D2_CUSTO1  <> 0
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	   	  THEN ((D2_CUSTO1/D2_QUANT)+((D2_CUSTO1/D2_QUANT)*0.07))
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB = '104' 
	   	   AND D2_CUSTO1  = 0
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NOT NULL--Tem fechamento SB9
	   	  THEN (B1_CUSTO)+((B1_CUSTO)*0.07)
	   	  ----------------------------
	   	  WHEN A1_GRPTRIB = '104' 
	   	   AND (SELECT MAX(B9_COD) FROM SB9010 SB9
	   	        WHERE SB9.D_E_L_E_T_  = ' ' AND SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) AND B9_DATA >='20150101'
	   	          AND D2_FILIAL = B9_FILIAL AND D2_LOCAL = B9_LOCAL AND D2_COD = B9_COD) IS NULL--Não Tem fechamento SB9
	   	  THEN (B1_CUSTO+(B1_CUSTO*0.07))
	   	  ----------------------------
	   	  ELSE 0
	   END AS CUSTO,
	   -------------------------------------------------------------------
	   --*/
	  B1_DESC,D2_QUANT,D2_TOTAL,F2_EMISSAO,D2_VALICM,D2_VALIMP5,D2_VALIMP6,D2_DOC,CLIENTE,A1_LOJA,D2_PEDIDO,D2_ITEM,D2_VALDEV,D2_QTDEDEV,DATAATUAL,F2_DOC,D2_DESCON,D2_PESO,A1_GRPTRIB,NOTA_FISCAL,D2_BASEICM,
	  D2_PRODUTIVIDADE,
	  D1_DTDIGIT,
	  D2_VALIPI,
	  (F2_FRETE/D2_QTD_ITEM) AS F2_FRETE_EXTRA
FROM(
SELECT --| Devolução |
	   D2_GRUPO, 
	   D2_FILIAL, 
	   --A3_COD, 
	   --A3_NOME, 
	   B1_COD,
	   B1_DESC, 
	   D2_QUANT, 
	   D2_TOTAL, 
	   F2_EMISSAO,
	   (D2_VALICM-D1_VALICM)   AS D2_VALICM, 
	   (D2_VALIMP5-D1_VALIMP5) AS D2_VALIMP5, 
	   (D2_VALIMP6-D1_VALIMP6) AS D2_VALIMP6, 
	   D2_DOC, 
	   -------------------------------------------------------------------
	   CASE
	   	  WHEN F2_AVALIST  = ' ' THEN A1_COD
	   	  WHEN F2_AVALIST <> ' ' THEN F2_AVALIST
	   	  ELSE 'ERRO'
	   END AS CLIENTE, 
	   -------------------------------------------------------------------
	   A1_LOJA, 
	   D2_PEDIDO, 
	   D2_ITEM,
	   (D1_TOTAL-D1_VALDESC)AS D2_VALDEV,
	   D2_QTDEDEV,
	   GETDATE() AS DATAATUAL,
	   F2_DOC,
	   D2_DESCON,
	   D2_PESO,
	   A1_GRPTRIB,
	   F2_DOC AS NOTA_FISCAL,
	   D2_BASEICM,
	   D2_COD,D2_LOCAL,D2_CUSTO1,B1_CUSTO,D2_EMISSAO,D2_TES,F4_ESTOQUE,F4_DUPLIC,F4_XCTR,
	   D2_CF,
	   (SELECT X5_DESCRI                             
	    FROM SX5010                                  
	    WHERE D_E_L_E_T_ = ' '                      
	   	  AND D2.D2_FILIAL = X5_FILIAL              
	   	  AND X5_TABELA = '13'                       
	   	  AND X5_CHAVE = D2.D2_CF)                  AS DESC_CODIGO_FISCAL,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  CASE
		  WHEN (SELECT MAX(SUBSTRING(C5.C5_EMISSAO,1,6))
		        FROM SC5010 C5
				WHERE C5.D_E_L_E_T_  = ' '
				  AND C5.C5_FILIAL   = D2.D2_FILIAL
				  AND C5.C5_NUM      = D2.D2_PEDIDO
			   ) >= SUBSTRING(D2_EMISSAO,1,6) THEN 'Mesmo mes'
		  ElSE 'Outro mes'
	  END AS D2_PRODUTIVIDADE,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  D1_DTDIGIT,
	  D2_VALIPI,
	  F2_VEND1,
	  F2_FRETE,
	  -------------------------------------------------------------------------------------------------------------------------------------------------
	  (SELECT COUNT(*)
	   FROM SD2010 A
	   WHERE A.D_E_L_E_T_ = ' '
	     AND A.D2_FILIAL  = D2.D2_FILIAL 
		 AND A.D2_DOC     =	D2.D2_DOC    
		 AND A.D2_SERIE   =	D2.D2_SERIE  
		 AND A.D2_CLIENTE =	D2.D2_CLIENTE
		 AND A.D2_LOJA    = D2.D2_LOJA ) AS D2_QTD_ITEM
	  -------------------------------------------------------------------------------------------------------------------------------------------------

FROM SD2010 D2, SF4010 F4, SF2010 F2, /*SA3010 A3,*/ SB1010 B1, SA1010 A1, SD1010 D1
WHERE D2.D_E_L_E_T_  = ' ' AND F4.D_E_L_E_T_  = ' ' AND F2.D_E_L_E_T_  = ' ' /*AND A3.D_E_L_E_T_  = ' '*/ AND B1.D_E_L_E_T_  = ' ' AND D1.D_E_L_E_T_  = ' '
  --------------------------------------------------------------------------------
  AND D1_FORNECE  = D2_CLIENTE AND D1_FILIAL = D2_FILIAL AND D1_COD = D2_COD AND D1_NFORI = D2_DOC AND D1_SERIORI = D2_SERIE AND D1_LOJA = D2_LOJA 
  --AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE   = 'S' AND F4_DUPLIC = 'S') OR (F4_ESTOQUE = 'S' AND F4_XCTR = 'S'))   
  AND D2_TES      = F4_CODIGO  AND ((F4_ESTOQUE = 'N' AND F4_DUPLIC = 'S')OR(F4_ESTOQUE = 'S' AND F4_DUPLIC = 'N'))
  --AND D2_TES      = F4_CODIGO  AND ((F4_DUPLIC = 'S') OR (F4_XCTR = 'S')) 
  AND D2_DOC      = F2_DOC     AND D2_SERIE = F2_SERIE AND D2_CLIENTE = F2_CLIENTE AND D2_LOJA = F2_LOJA AND D2_FILIAL = F2_FILIAL
  AND D2_CLIENTE  = A1_COD     AND D2_LOJA = A1_LOJA
  --AND F2_VEND1    = A3_COD 
  AND D2_COD      = B1_COD
  --------------------------------------------------------------------------------
  AND SUBSTRING(D2_EMISSAO,1,4) >= '2022'--'2015'
  --AND D2_EMISSAO < '20200304'
  AND F2_TIPO     = 'N'
  AND D2_CF NOT IN('7949')
  AND D2_QTDEDEV <> 0 
  --------------------------------------------------------------------------------
  /*
  AND D2_CUSTO1  <> 0  
  AND F2_AVALIST  = ' '       
  AND A1_GRPTRIB <> '104'      
  AND EXISTS (SELECT B9_COD 
              FROM SB9010 
              WHERE SUBSTRING(D2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6) 
                AND D2_FILIAL                 = B9_FILIAL 
                AND D2_LOCAL                  = B9_LOCAL 
                AND D2_COD                    = B9_COD )
  */
  --------------------------------------------------------------------------------
)APL4
----------------------------------------------------------------------------------
LEFT  JOIN SB9010 B9 ON B9.D_E_L_E_T_  = ' ' -- Saldos de Fechamentos de Esotque
                    AND D2_COD         = B9_COD     
					AND D2_FILIAL      = B9_FILIAL 
					AND D2_LOCAL       = B9_LOCAL
					AND SUBSTRING(F2_EMISSAO,1,6) = SUBSTRING(B9_DATA,1,6)
----------------------------------------------------------------------------------
LEFT JOIN SB2010 B2 ON B2.D_E_L_E_T_  = ' ' -- Saldos Atuais
                   AND D2_COD         = B2_COD   
				   AND D2_FILIAL      = B2_FILIAL
				   AND D2_LOCAL       = B2_LOCAL
----------------------------------------------------------------------------------
LEFT JOIN SA3010 A3 ON A3.D_E_L_E_T_  = ' ' -- Vendedores
                   AND F2_VEND1       = A3.A3_COD
----------------------------------------------------------------------------------

)APL
)APL10]]></attr>
</Node>
