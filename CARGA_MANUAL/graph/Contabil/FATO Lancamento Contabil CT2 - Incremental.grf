<attr name="transform"><![CDATA[//#CTL2

// Transforms input record into output record.
function integer transform() {
	
	$out.0.syntax_content = 'DELETE FROM {attr.lancamentocontabilct2.factsof} WHERE {datalancamentocontabil.date.yyyymmdd} BETWEEN '+'"'+date2str($in.0.Min_Date, "yyyyMMdd")+'" AND "'+date2str($in.0.Max_Date, "yyyyMMdd")+'"';
	
	return ALL;
}

