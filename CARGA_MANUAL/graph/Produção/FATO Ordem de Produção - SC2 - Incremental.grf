// Transforms input record into output record.
function integer transform() {
	
	$out.0.syntax_content = 'DELETE FROM {attr.ordensdeproducaosc2.factsof} WHERE {datadeemissaoordemproducaosc2.date.yyyymmdd} BETWEEN '+'"'+date2str($in.0.Min_Date, "yyyyMMdd")+'" AND "'+date2str($in.0.Max_Date, "yyyyMMdd")+'"';
	
	return ALL;
}

