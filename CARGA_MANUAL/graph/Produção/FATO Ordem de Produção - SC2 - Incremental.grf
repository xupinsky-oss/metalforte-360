<Node dbConnection="JDBC0" enabled="enabled" guiName="Ordens de Produção SC2" guiX="12" guiY="32" id="ORDENS_DE_PRODUCAO_SC2" type="DB_INPUT_TABLE">
<attr name="sqlQuery"><![CDATA[SELECT 
	  C2_FILIAL, 
	  C2_NUM, 
	  C2_ITEM, 
	  C2_SEQUEN, 
	  C2_PRODUTO, 
	  C2_LOCAL, 
	  C2_CC, 
	  C2_QUANT, 
	  C2_UM, 
	  C2_OBS, 
	  C2_EMISSAO, 
	  C2_QUJE, 
	  C2_DATRF, 
	  C2_SEGUM, 
	  C2_PERDA, 
	  C2_PEDIDO, 
	  C2_ITEMPV, 
	  C2_QTSEGUM, 
	  C2_VEND1, 
	  C2_IMPOP, 
	  C2_GRUPOP, 
	  C2_SOBENCO, 
	  C2_VALOR, 
	  C2_CLIENTE, 
	  C2_DATPRF,
	  C2_TPOP,
	  C2_ATRASO_PRAZO,
	  C2_DIAS,
	  C2_DATCONF,
	  C2_DATDESE,
	  'Dia ' + CONVERT(VARCHAR(10), GETDATE(), 103) + ' as ' + CONVERT(VARCHAR(8), GETDATE(), 108) AS C2_DATA_CARGA
FROM dbo.GD_FATO_ORDEM_PRODUCAO_SC2
WHERE C2_EMISSAO >= CONVERT(VARCHAR(8), DATEADD(D,-60,GETDATE()), 112)]]></attr>
</Node>
