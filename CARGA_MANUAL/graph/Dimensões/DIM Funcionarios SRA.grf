<attr name="transform"><![CDATA[//#CTL2

// Transforms input record into output record.
function integer transform() {
	if ($in.0.RA_MAT <='000999' || $in.0.RA_MAT >'000999'){
	$out.0.RA_FILIAL = $in.0.RA_FILIAL;
	$out.0.RA_MAT = $in.0.RA_MAT;
	$out.0.RA_NOME = $in.0.RA_NOME;
	$out.0.CTT_DESC01 = $in.0.CTT_DESC01;
	$out.0.QB_DESCRIC = $in.0.QB_DESCRIC;
	$out.0.RJ_DESC = $in.0.RJ_DESC;
	$out.0.X5_DESCRI = $in.0.X5_DESCRI;
	$out.0.RA_SITFOLH = $in.0.RA_SITFOLH;	
	$out.0.COUNT = $in.0.COUNT;
	if ($in.0.RA_ADMISSA == "        "){
		$out.0.RA_ADMISSA = str2date('19900101','yyyyMMdd');
	}else {
		$out.0.RA_ADMISSA = str2date($in.0.RA_ADMISSA,'yyyyMMdd');
	}
	if ($in.0.RA_DEMISSA == "        "){
		$out.0.RA_DEMISSA = str2date('19900101','yyyyMMdd');
	}else {
		$out.0.RA_DEMISSA = str2date($in.0.RA_DEMISSA,'yyyyMMdd');
	}
	
	if ($in.0.RA_SITFOLH == 'D'){
		$out.1.RA_MAT = $in.0.RA_MAT;
		$out.1.RA_SITFOLH = $in.0.RA_SITFOLH;	
		$out.1.COUNT = $in.0.COUNT;
		if ($in.0.RA_DEMISSA == "        "){
			$out.1.RA_DEMISSA = str2date('19900101','yyyyMMdd');
		}else {
			$out.1.RA_DEMISSA = str2date($in.0.RA_DEMISSA,'yyyyMMdd');
		}
	}
	if ($in.0.RA_SITFOLH <> 'D'){
		$out.2.RA_MAT = $in.0.RA_MAT;
		$out.2.RA_SITFOLH = $in.0.RA_SITFOLH;	
		$out.2.COUNT = $in.0.COUNT;
		if ($in.0.RA_ADMISSA == "        "){
			$out.2.RA_ADMISSA = str2date('19900101','yyyyMMdd');
		}else {
			$out.2.RA_ADMISSA = str2date($in.0.RA_ADMISSA,'yyyyMMdd');
		}	
	}	
	}
	

	return ALL;
}

