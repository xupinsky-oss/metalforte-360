// Transforms input record into output record.
function integer transform() {
	$out.0.CT1_CONTA = $in.0.CT1_CONTA;
	$out.0.CT1_DESC01 = $in.0.CT1_DESC01;
	$out.0.CT1_CLASSE = $in.0.CT1_CLASSE;
	$out.0.CT1_NORMAL = $in.0.CT1_NORMAL;
	$out.0.CT1_CONTA_N1 = $in.0.CT1_CONTA_N1;
	$out.0.CT1_CONTA_N2 = $in.0.CT1_CONTA_N2;
	$out.0.CT1_CONTA_N3 = $in.0.CT1_CONTA_N3;
	$out.0.CT1_CONTA_N4 = $in.0.CT1_CONTA_N4;
	$out.0.CT1_CONTA_N5 = $in.0.CT1_CONTA_N5;
	$out.0.CT1_CLASSIFICACAO1_ORC = $in.0.CT1_CLASSIFICACAO1_ORC;
	$out.0.CT1_CLASSIFICACAO2_ORC = $in.0.CT1_CLASSIFICACAO2_ORC;

	return ALL;
}

