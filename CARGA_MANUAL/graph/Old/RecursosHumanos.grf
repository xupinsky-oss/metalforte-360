<Phase number="10">
<Node dbConnection="JDBC0" enabled="enabled" guiName="SRA- Funcionário" guiX="-316" guiY="123" id="SRA_FUNCIONARIO" type="DB_INPUT_TABLE">
<attr name="sqlQuery"><![CDATA[SELECT RA_FILIAL,RA_MAT,RA_NOME,CTT_DESC01,QB_DESCRIC,RJ_DESC,X5_DESCRI,RA_ADMISSA,RA_DEMISSA,RA_SITFOLH,1
FROM SRA010 RA, SQB010 QB,CTT010 CTT,SX5010 X5, SRJ010 RJ 
WHERE   RA.D_E_L_E_T_ = '' AND QB.D_E_L_E_T_ = '' AND CTT.D_E_L_E_T_ = '' AND X5.D_E_L_E_T_ = '' AND RJ.D_E_L_E_T_ = '' 
AND RA_DEPTO *= QB_DEPTO 
AND RA_CC = CTT_CUSTO
AND X5_TABELA = '31' 
AND RA_SITFOLH = X5_CHAVE 
AND RA_CODFUNC = RJ_FUNCAO 
]]></attr>
</Node>
<Edge debugMode="true" fromNode="SRA_FUNCIONARIO:0" guiBendpoints="" guiRouter="Manhattan" id="Edge1" inPort="Port 0 (in)" metadata="Metadata2" outPort="Port 0 (out)" toNode="REFORMAT:0"/>
</Phase>
<Phase number="11">
<Node enabled="enabled" guiName="Reformat" guiX="-115" guiY="123" id="REFORMAT" type="REFORMAT">
<attr name="transform"><![CDATA[//#CTL2

// Transforms input record into output record.
function integer transform() {
	if ($in.0.RA_MAT <='000999'){
	$out.0.RA_FILIAL = $in.0.RA_FILIAL;
	$out.0.RA_MAT = $in.0.RA_MAT;
	$out.0.RA_NOME = $in.0.RA_NOME;
	$out.0.CTT_DESC01 = $in.0.CTT_DESC01;
	$out.0.QB_DESCRIC = $in.0.QB_DESCRIC;
	$out.0.RJ_DESC = $in.0.RJ_DESC;
	$out.0.X5_DESCRI = $in.0.X5_DESCRI;
	$out.0.RA_SITFOLH = $in.0.RA_SITFOLH;	
	$out.0.COUNT = $in.0.COUNT;
	if ($in.0.RA_ADMISSA == "        "){
		$out.0.RA_ADMISSA = str2date('19900101','yyyyMMdd');
	}else {
		$out.0.RA_ADMISSA = str2date($in.0.RA_ADMISSA,'yyyyMMdd');
	}
	if ($in.0.RA_DEMISSA == "        "){
		$out.0.RA_DEMISSA = str2date('19900101','yyyyMMdd');
	}else {
		$out.0.RA_DEMISSA = str2date($in.0.RA_DEMISSA,'yyyyMMdd');
	}
	
	if ($in.0.RA_SITFOLH == 'D'){
		$out.1.RA_MAT = $in.0.RA_MAT;
		$out.1.RA_SITFOLH = $in.0.RA_SITFOLH;	
		$out.1.COUNT = $in.0.COUNT;
		if ($in.0.RA_DEMISSA == "        "){
			$out.1.RA_DEMISSA = str2date('19900101','yyyyMMdd');
		}else {
			$out.1.RA_DEMISSA = str2date($in.0.RA_DEMISSA,'yyyyMMdd');
		}
	}
	if ($in.0.RA_SITFOLH <> 'D'){
		$out.2.RA_MAT = $in.0.RA_MAT;
		$out.2.RA_SITFOLH = $in.0.RA_SITFOLH;	
		$out.2.COUNT = $in.0.COUNT;
		if ($in.0.RA_ADMISSA == "        "){
			$out.2.RA_ADMISSA = str2date('19900101','yyyyMMdd');
		}else {
			$out.2.RA_ADMISSA = str2date($in.0.RA_ADMISSA,'yyyyMMdd');
		}	
	}	
	}
	

	return ALL;
}

