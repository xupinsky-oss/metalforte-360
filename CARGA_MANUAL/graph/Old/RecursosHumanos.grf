<Phase number="4">
<Node dbConnection="JDBC0" enabled="enabled" guiName="Contador de Colaboradores" guiX="-319" guiY="341" id="CONTADOR_DE_COLABORADORES" type="DB_INPUT_TABLE">
<attr name="sqlQuery"><![CDATA[SELECT COUNT (DISTINCT RD_MAT) AS   QTDE_COLABORADOR,RD_FILIAL,RD_MAT,DATEADD(DD,-DAY(RD_DATPGT),RD_DATPGT) AS DATA_CONTAGEM
FROM SRA010 RA,SRD010  RD WHERE RA.D_E_L_E_T_ = '' AND RD.D_E_L_E_T_ = ''  
AND RD_MAT = RD_MAT
AND RA_FILIAL = RD_FILIAL 
AND ( RA_ADMISSA <= DATEADD(DD,-DAY(RD_DATPGT),RD_DATPGT)) AND (RA_DEMISSA = '' OR  RA_DEMISSA > DATEADD(mm, DATEDIFF(mm, 0, RD_DATPGT), 0))  
AND RD_MAT <= '000999' 
AND RD_DATPGT >='20150101'
AND RD_MAT NOT IN ('000096','000097','000741','000749','000755')
AND SUBSTRING (RD_DATPGT,7,2) = '05'
GROUP BY RD_FILIAL,RD_MAT,RD_DATPGT]]></attr>
</Node>
