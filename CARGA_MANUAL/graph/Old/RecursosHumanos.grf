<Node dbConnection="JDBC0" enabled="enabled" guiName="SRD - Acumulados Anuais " guiX="-316" guiY="19" id="SRD_ACUMULADOS_ANUAIS" type="DB_INPUT_TABLE">
<attr name="sqlQuery"><![CDATA[SELECT RA_FILIAL,RA_MAT,RA_NOME,CTT_CUSTO,CTT_DESC01,QB_DEPTO,QB_DESCRIC,RV_COD,RV_DESC,RD_DATPGT,RD_VALOR,RD_DATARQ,0 RD_HORAS,X5_DESCRI,DATEADD(DD,-DAY(RD_DATPGT),RD_DATPGT)AS DATA_COMPTENCIA,RD_FILIAL 
FROM SRA010 RA, SQB010 QB,SRD010 RD, SRV010 RV, CTT010 CTT, SX5010 X5
WHERE RA.D_E_L_E_T_ = '' AND QB.D_E_L_E_T_ = '' AND RD.D_E_L_E_T_ = '' AND RV.D_E_L_E_T_ = ''  AND CTT.D_E_L_E_T_ = '' 
AND RA_DEPTO *= QB_DEPTO 
AND RA_MAT = RD_MAT 
AND RA_FILIAL = RD_FILIAL 
AND RD_DATPGT  >= '20150101'  
AND RD_PD = RV_COD  AND 
(RV_TIPOCOD = '1' or (RV_TIPOCOD = '3' AND RV_COD IN ('915','815','708', '710', '717', '718', '750', '751', '752', '807','919', '920', '921')))
AND RA_CC = CTT_CUSTO
AND RV_COD NOT IN  ('134','137')
AND X5_TABELA = '31' 
AND RA_SITFOLH = X5_CHAVE 
AND SUBSTRING(RD_DATPGT,1,6) <> SUBSTRING(RD_DATARQ,1,6)
UNION
SELECT RA_FILIAL,RA_MAT,RA_NOME,CTT_CUSTO,CTT_DESC01,QB_DEPTO,QB_DESCRIC,RV_COD,RV_DESC,RD_DATPGT,RD_VALOR,RD_DATARQ,0 RD_HORAS,X5_DESCRI,DATEADD(s,-1,DATEADD(mm, DATEDIFF(m,0,RD_DATPGT)+1,0))AS DATA_COMPTENCIA,RD_FILIAL  
FROM SRA010 RA, SQB010 QB,SRD010 RD, SRV010 RV, CTT010 CTT, SX5010 X5
WHERE RA.D_E_L_E_T_ = '' AND QB.D_E_L_E_T_ = '' AND RD.D_E_L_E_T_ = '' AND RV.D_E_L_E_T_ = ''  AND CTT.D_E_L_E_T_ = '' 
AND RA_DEPTO *= QB_DEPTO 
AND RA_MAT = RD_MAT 
AND RA_FILIAL = RD_FILIAL 
AND RD_DATPGT  >= '20150101'  
AND RD_PD = RV_COD  AND 
(RV_TIPOCOD = '1' or (RV_TIPOCOD = '3' AND RV_COD IN ('915','815','708', '710', '717', '718', '750', '751', '752', '807','919', '920', '921')))
AND RA_CC = CTT_CUSTO
AND RV_COD NOT IN  ('134','137')
AND X5_TABELA = '31' 
AND RA_SITFOLH = X5_CHAVE 
AND SUBSTRING(RD_DATPGT,1,6) = SUBSTRING(RD_DATARQ,1,6)
UNION
