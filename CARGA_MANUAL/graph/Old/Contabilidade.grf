<Phase number="7">
<Node dbConnection="JDBC0" enabled="enabled" guiName="Lançamento Contábil CT2" guiX="30" guiY="188" id="LANCAMENTO_CONTABIL_CT2" type="DB_INPUT_TABLE">
<attr name="sqlQuery"><![CDATA[SELECT 'DEBITO' AS TIPO, CT2_FILIAL, CT2_DATA, CT2_DC, CT2_DEBITO AS CONTA,CT2_VALOR, CT2_HIST, CT2_CCD AS CC,CT2_ITEMD AS ITEM, CT2_CLVLDB AS CLASSE,DATEADD(DD, -DAY(DATEADD(M, 1, CT2_DATA)), DATEADD(M, 1, CT2_DATA))AS CT2_DTA,CT2_DOC,R_E_C_N_O_ 
FROM CT2010 
WHERE  D_E_L_E_T_ = ' ' AND CT2_DATA >= '20150101'  AND CT2_HP <> '999' AND CT2_DEBITO <> '1140700001'
AND CT2_CREDIT = ''
UNION
