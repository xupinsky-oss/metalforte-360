<attr name="transform"><![CDATA[//#CTL2

// Transforms input record into output record.
function integer transform() {
	$out.0.R8_FILIAL = $in.0.R8_FILIAL;
	$out.0.R8_MAT = $in.0.R8_MAT;
	$out.0.R8_SEQ = $in.0.R8_SEQ;
	$out.0.R8_DATA = $in.0.R8_DATA;
	$out.0.R8_TIPO = $in.0.R8_TIPO;
	$out.0.R8_DATAINI = $in.0.R8_DATAINI;
	if ($in.0.R8_DATAFIM == "        "){
		$out.0.R8_DATAFIM = str2date('19900101','yyyyMMdd');
	}else {
		$out.0.R8_DATAFIM = str2date($in.0.R8_DATAFIM,'yyyyMMdd');
	}	
	$out.0.COUNT = $in.0.COUNT;

	return ALL;
}

