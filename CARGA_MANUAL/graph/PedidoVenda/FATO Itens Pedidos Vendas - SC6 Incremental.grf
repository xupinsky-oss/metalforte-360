<Node dbConnection="JDBC0" enabled="enabled" guiName="SC6 Itens do Pedido de Venda" guiX="3" guiY="20" id="SC6_ITENS_DO_PEDIDO_DE_VENDA1" type="DB_INPUT_TABLE">
<attr name="sqlQuery"><![CDATA[SELECT 
	  C6_ITEM, 
	  C6_TIPOPED, 
	  C6_PRODUTO, 
	  C6_DESCRI, 
	  C6_UM, 
	  C6_QTDVEN, 
	  C6_DESCONT, 
	  C6_SEGUM, 
	  C6_PRCVEN, 
	  C6_VALOR, 
	  C6_UNSVEN, 
	  C6_QTDENT, 
	  C6_TES, 
	  C6_ENTREG, 
	  C6_CF, 
	  C6_CLI, 
	  C6_VALDESC, 
	  C6_NOTA, 
	  C6_NUM, 
	  C6_PRUNIT, 
	  C6_OP, 
	  C6_BLQ, 
	  C6_NUMOP, 
	  C6_CONTRAT, 
	  C6_QTDEMP, 
	  C6_COMPR, 
	  C6_PECAS, 
	  C6_DIAS, 
	  C6_LISTA, 
	  C6_VEND1, 
	  C6_PRC2UM, 
	  C6_XPERD, 
	  C6_SUGENTR, 
	  C6_XMOTIVO, 
	  C5_EMISSAO, 
	  C6_NUMII,
	  CONTA_PEDIDO,
	  FK_GRUPO_PROD,
	  ZT_MOTIVO,
	  SC6_CUSTO_MEDIO,
	  SC6_IMPOSTO_MEDIO,
	  C6_DATA_CARGA,
	  FK_SC5,
	  FK_DELET
	  
FROM dbo.GD_FATO_PEDIDO_VENDA_ITENS_SC6
WHERE C5_EMISSAO >= CONVERT(VARCHAR(8), DATEADD(D,-60,GETDATE()), 112)]]></attr>
</Node>
