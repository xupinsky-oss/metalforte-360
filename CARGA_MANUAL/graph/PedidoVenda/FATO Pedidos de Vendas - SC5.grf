<attr name="transform"><![CDATA[//#CTL2

// Transforms input record into output record.
function integer transform() {
	
	string load_mode = '${LOAD_MODE_FCT}';
	if (upperCase(load_mode) == 'INCREMENTAL') {
        $out.0.syntax_content = 'DELETE FROM {attr.sc5pedidodevenda.pedido} WHERE {emissaopedidosc5.date.yyyymmdd} BETWEEN '+'"'+date2str($in.0.Min_Date, "yyyyMMdd")+'" AND "'+date2str($in.0.Max_Date, "yyyyMMdd")+'"';
	} else {
		$out.0.syntax_content = 'DELETE FROM {attr.sc5pedidodevenda.pedido}';
	}
	
	return ALL;
}

